/*
 * ZPLC Board Overlay - Raspberry Pi Pico (RP2040)
 * SPDX-License-Identifier: MIT
 *
 * The RPi Pico board defines led0 as the on-board LED (GP25). This profile
 * re-points led0 to GP0 so that DO0 to DO3 are four header pins, and maps the
 * on-board LED as led4 (DO4, %QX0.4).
 *
 * This overlay:
 *   - Enables USB CDC ACM as the console/shell interface
 *   - Maps four outputs (GP0-GP3) and the on-board LED (GP25)
 *   - Maps four inputs (GP15, GP14, GP13, GP12), switches to GND
 *   - Defines a storage partition for NVS (program persistence)
 *
 * The channels are listed, with their header pins and electrical notes, in the
 * I/O description of firmware/app/boards/boards.json (rpi-pico-rp2040); the
 * build fails when the description and this file disagree.
 *
 * Hardware connection:
 *   GP0..GP3   -> LED -> resistor -> GND   (outputs, header pins 1, 2, 4, 5)
 *   GP15..GP12 -> switch -> GND            (inputs, internal pull-up)
 *   GP4, GP5   -> Modbus RTU on UART1 (TX, RX; header pins 6, 7), 3.3 V logic:
 *                 an RS-485 transceiver or a 3.3 V USB-serial adapter
 *
 * UART0 of the board DTS (GP0, GP1) and I2C0 (GP4, GP5) are disabled: their pins
 * are DO0 and DO1, and the Modbus RTU port. The console stays on USB CDC ACM.
 *
 * Flash Layout (2MB total):
 *   0x000000 - 0x0000FF: second-stage bootloader
 *   0x000100 - 0x1DFFFF: Application code, code_partition (1920 KB less 256 bytes)
 *   0x1E0000 - 0x1FFFFF: NVS Storage (128 KB): two program slots of 24 KB, the two RETAIN records
 *                        and a spare sector, which 64 KB cannot hold (RT-025, RT-029)
 * The upstream code_partition runs to the end of the flash; it ends here before
 * the NVS storage, so the linker refuses an image that would grow into it (IO-008).
 */

/ {
    chosen {
        /* Use USB CDC ACM for console and shell */
        zephyr,console = &cdc_acm_uart0;
        zephyr,shell-uart = &cdc_acm_uart0;
    };

    zephyr,user {
        /* ADC channel 4 is the internal temperature sensor on RP2040 */
        io-channels = <&adc 4>;
        io-channel-names = "temp";
    };

    gpio_keys {
        compatible = "gpio-keys";
        
        /* User button on GPIO15 with internal pull-up */
        button0: button_0 {
            gpios = <&gpio0 15 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "ZPLC Input 0";
            zephyr,code = <0>;
        };
        button1: button_1 {
            gpios = <&gpio0 14 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "ZPLC Input 1 (GP14)";
            zephyr,code = <1>;
        };
        button2: button_2 {
            gpios = <&gpio0 13 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "ZPLC Input 2 (GP13)";
            zephyr,code = <2>;
        };
        button3: button_3 {
            gpios = <&gpio0 12 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "ZPLC Input 3 (GP12)";
            zephyr,code = <3>;
        };
    };
    
    leds {
        compatible = "gpio-leds";
        led0: led_0 {
            gpios = <&gpio0 0 GPIO_ACTIVE_HIGH>;
            label = "ZPLC Output 0 (GP0)";
        };
        led1: led_1 {
            gpios = <&gpio0 1 GPIO_ACTIVE_HIGH>;
            label = "ZPLC Output 1 (GP1)";
        };
        led2: led_2 {
            gpios = <&gpio0 2 GPIO_ACTIVE_HIGH>;
            label = "ZPLC Output 2 (GP2)";
        };
        led3: led_3 {
            gpios = <&gpio0 3 GPIO_ACTIVE_HIGH>;
            label = "ZPLC Output 3 (GP3)";
        };
        /* The on-board LED: led0 of the board DTS is re-pointed above, so it gets its own node (IO-009) */
        led4: led_4 {
            gpios = <&gpio0 25 GPIO_ACTIVE_HIGH>;
            label = "ZPLC Output 4 (GP25, on-board LED)";
        };
    };

    aliases {
        sw0 = &button0;
        sw1 = &button1;
        sw2 = &button2;
        sw3 = &button3;
        led4 = &led4;
        led0 = &led0;
        led1 = &led1;
        led2 = &led2;
        led3 = &led3;
    };
};

/* UART0 sits on GP0 and GP1, which are DO0 and DO1 of this profile */
&uart0 {
    status = "disabled";
};

/* I2C0 sits on GP4 and GP5, which carry the Modbus RTU port */
&i2c0 {
    status = "disabled";
};

&pinctrl {
    uart1_default: uart1_default {
        group1 {
            pinmux = <UART1_TX_P4>;
        };

        group2 {
            pinmux = <UART1_RX_P5>;
            input-enable;
        };
    };
};

/* Modbus RTU (COM-012, HIL-010): UART1 on GP4 (TX, header pin 6) and GP5 (RX, header pin 7) */
&uart1 {
    status = "okay";
    current-speed = <19200>;
    pinctrl-0 = <&uart1_default>;
    pinctrl-names = "default";

    modbus0: modbus0 {
        compatible = "zephyr,modbus-serial";
        status = "okay";
    };
};

/* Enable ADC for analog input */
&adc {
    status = "okay";
    #address-cells = <1>;
    #size-cells = <0>;
};

/* Define flash partitions for NVS storage */
&flash0 {
    partitions {
        compatible = "fixed-partitions";
        #address-cells = <1>;
        #size-cells = <1>;

        /*
         * Storage partition for NVS (Non-Volatile Storage), at the end of the flash: 128 KB for the two program
         * slots of CONFIG_ZPLC_CODE_SIZE_MAX, the two RETAIN records and the device settings, with a spare sector
         */
        storage_partition: partition@1e0000 {
            label = "storage";
            reg = <0x1e0000 0x20000>;
        };
    };
};

/* The image slot ends where the NVS storage begins (IO-008). */
&code_partition {
    reg = <0x100 (0x1e0000 - 0x100)>;
};

/* Enable USB and configure CDC ACM device */
&zephyr_udc0 {
    cdc_acm_uart0: cdc_acm_uart0 {
        compatible = "zephyr,cdc-acm-uart";
    };
};
