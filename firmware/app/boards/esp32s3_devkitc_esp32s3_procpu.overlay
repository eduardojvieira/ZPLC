/*
 * ZPLC Board Overlay - Espressif ESP32-S3-DevKitC-1 (module N8R8)
 * SPDX-License-Identifier: MIT
 *
 * Module: ESP32-S3-WROOM-1-N8R8, 8 MB flash and 8 MB octal PSRAM. The base board
 * DTS targets the N8 module (8 MB flash, no PSRAM): the flash needs no override
 * and psram0 is overridden below. If the marking on your module is another
 * variant, change the sizes here and in the "hardware" object of boards.json.
 *
 * The on-board LED (GPIO48) is an addressable RGB part that needs the LED-strip
 * driver, so the profile does not use it. It exposes simple GPIO instead:
 *
 *   Outputs   GPIO38, GPIO15, GPIO16, GPIO17  -> LED -> resistor -> GND
 *   Inputs    GPIO0 (BOOT button), GPIO18, GPIO8, GPIO9  -> switch -> GND
 *   Analog    GPIO4 (ADC1 channel 3), 0 V to about 3.1 V
 *
 * GPIO35 to GPIO37 are used by the octal PSRAM of this module: avoid them. The
 * pins other than the BOOT button, GPIO38 and GPIO15 are a choice of this
 * profile (pin_status "profile" in the I/O description) and need the loopback
 * bench of HIL-010 to be confirmed.
 *
 * The channels are listed in the I/O description of
 * firmware/app/boards/boards.json (esp32-s3-devkitc); the build fails when the
 * description and this file disagree.
 *
 * Console:
 *   Zephyr console and shell use the native USB-Serial/JTAG controller, the
 *   same USB port that is used for flashing.
 *
 * NVS storage:
 *   ESP32 uses its own NVS partition from the base devicetree: no additional
 *   overlay is needed for program persistence.
 *
 * Settings of the LilyGo T-Display S3 (16 MB flash) are in
 * profiles/lilygo_tdisplay_s3.overlay, which is layered on top of this file.
 */

/* ESP32-S3R8 class module: 8 MB octal PSRAM, needed for CONFIG_ESP_SPIRAM */
&psram0 {
    size = <DT_SIZE_M(8)>;
};

/ {
    chosen {
        zephyr,console = &usb_serial;
        zephyr,shell-uart = &usb_serial;
    };

    leds {
        compatible = "gpio-leds";

        led0: led_0 {
            gpios = <&gpio1 6 GPIO_ACTIVE_HIGH>;  /* GPIO38 = gpio1 pin 6 */
            label = "ZPLC Output 0 (GPIO38)";
        };

        led1: led_1 {
            gpios = <&gpio0 15 GPIO_ACTIVE_HIGH>;  /* GPIO15 = gpio0 pin 15 */
            label = "ZPLC Output 1 (GPIO15)";
        };

        led2: led_2 {
            gpios = <&gpio0 16 GPIO_ACTIVE_HIGH>;
            label = "ZPLC Output 2 (GPIO16)";
        };

        led3: led_3 {
            gpios = <&gpio0 17 GPIO_ACTIVE_HIGH>;
            label = "ZPLC Output 3 (GPIO17)";
        };
    };

    zplc_inputs {
        compatible = "gpio-keys";

        button1: button_1 {
            gpios = <&gpio0 18 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "ZPLC Input 1 (GPIO18)";
            zephyr,code = <1>;
        };

        button2: button_2 {
            gpios = <&gpio0 8 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "ZPLC Input 2 (GPIO8)";
            zephyr,code = <2>;
        };

        button3: button_3 {
            gpios = <&gpio0 9 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "ZPLC Input 3 (GPIO9)";
            zephyr,code = <3>;
        };
    };

    aliases {
        led0 = &led0;
        led1 = &led1;
        led2 = &led2;
        led3 = &led3;
        sw1 = &button1;
        sw2 = &button2;
        sw3 = &button3;
        /* sw0 is the BOOT button, defined by the base board DTS */
    };
};

&usb_serial {
    status = "okay";
};

/* ADC1 serves the analog input AI0 (GPIO4, channel 3) */
&adc0 {
    status = "okay";
};
