# =============================================================================
# ZPLC Kconfig
# =============================================================================
# SPDX-License-Identifier: MIT
#
# Zephyr Kconfig options for the ZPLC runtime module.
# =============================================================================

menuconfig ZPLC
    bool "ZPLC PLC Runtime"
    help
      Enable the ZPLC IEC 61131-3 PLC runtime.
      This provides a portable virtual machine for executing
      PLC programs compiled to the .zplc bytecode format.

if ZPLC

config ZPLC_STACK_DEPTH
    int "Evaluation stack depth"
    default 256
    help
      Maximum depth of the VM evaluation stack.
      Each entry is 4 bytes (32-bit).

config ZPLC_CALL_STACK_DEPTH
    int "Call stack depth"
    default 32
    help
      Maximum call nesting depth for subroutines.

config ZPLC_WORK_MEMORY_SIZE
    int "Work memory size (bytes)"
    default 8192
    help
      Size of the work memory region for temporary variables.

config ZPLC_RETAIN_MEMORY_SIZE
    int "Retentive memory size (bytes)"
    default 4096
    help
      Size of the retentive memory region.
      This memory is persisted across power cycles.

config ZPLC_CODE_SIZE_MAX
    int "Maximum code size (bytes)"
    default 45056
    help
      Maximum size of the bytecode segment.

config ZPLC_REQUIRED_GPIO_OUTPUT_MASK
    hex "Required logical digital-output mask"
    range 0x0 0xF
    default 0x0
    help
      Bit mask of logical DO0-DO3 channels that must be configured from
      DeviceTree for this profile to initialize the Zephyr HAL. A missing or
      unconfigurable required channel fails HAL initialization; this setting
      does not qualify the electrical behavior of any mapped pin.

config ZPLC_VM_CYCLE_INSTRUCTION_BUDGET
    int "PLC scan instruction budget"
    default 100000
    range 1 10000000
    help
      Maximum VM instructions permitted in one production PLC scan. Reaching
      the limit is a controlled logical VM watchdog fault. It is not a physical
      watchdog, timing measurement, or WCET guarantee.

config ZPLC_LOG_LEVEL
    int "Log level"
    default 3
    range 0 4
    help
      Log level for ZPLC runtime.
      0=OFF, 1=ERR, 2=WRN, 3=INF, 4=DBG

# -----------------------------------------------------------------------------
# Multitask Scheduler Configuration
# -----------------------------------------------------------------------------

config ZPLC_SCHEDULER
    bool "Enable multitask scheduler"
    default n
    help
      Enable the ZPLC multitask scheduler.
      Allows running multiple PLC tasks with different intervals
      and priorities using Zephyr's k_timer and work queue system.

if ZPLC_SCHEDULER

config ZPLC_HARDWARE_WATCHDOG
    bool "Enable the profile-owned hardware watchdog"
    default n
    depends on WATCHDOG
    help
      Arms the Zephyr watchdog only while a ZPLC scheduler batch completes
      input snapshot, all due tasks, deadline checks, and one normal output
      commit. It is never fed by an ISR, timer, shell, network, or idle path.

      This default is intentionally off. Enable it only in an exact
      board/revision profile after HIL has verified watchdog reset timing and
      safe outputs. The VM instruction budget remains a logical fault limit;
      it is not this physical watchdog.

config ZPLC_HARDWARE_WATCHDOG_TIMEOUT_MS
    int "Hardware watchdog timeout (ms)"
    range 100 60000
    default 1000
    depends on ZPLC_HARDWARE_WATCHDOG
    help
      Exact profile-owned timeout passed to the Zephyr watchdog driver. This
      setting has no evidence value until HIL verifies the selected device.

config ZPLC_MAX_TASKS
    int "Maximum number of concurrent tasks"
    default 8
    range 2 16
    help
      Maximum number of PLC tasks that can be registered.
      Each task requires approximately 1KB of RAM for its VM state.

config ZPLC_SCHED_WORKQ_STACK_SIZE
    int "Scheduler work queue stack size"
    default 2048
    help
      Stack size for the scheduler work queue thread.
      Increase if tasks require deeper call stacks.

config ZPLC_SCHED_WORKQ_PRIORITY
    int "Scheduler work queue priority"
    default 5
    range 0 14
    help
      Priority of the scheduler work queue thread.
      Lower values = higher priority.
      0 = highest (preempts almost everything)
      14 = lowest cooperative priority

config ZPLC_SCHED_HIGH_PRIO_WORKQ
    bool "Use separate high-priority work queue"
    default y
    help
      Run the single scheduler batch coordinator on a dedicated high-priority
      work queue. Task ordering remains deterministic within each batch.

config ZPLC_SCHED_HIGH_PRIO_STACK_SIZE
    int "High-priority work queue stack size"
    default 2048
    depends on ZPLC_SCHED_HIGH_PRIO_WORKQ
    help
      Stack size for the high-priority work queue thread.

config ZPLC_SCHED_HIGH_PRIO_PRIORITY
    int "High-priority work queue thread priority"
    default 2
    range 0 14
    depends on ZPLC_SCHED_HIGH_PRIO_WORKQ
    help
      Priority of the high-priority work queue thread.
      Should be lower (higher priority) than ZPLC_SCHED_WORKQ_PRIORITY.

# -----------------------------------------------------------------------------
# RETAIN persistence (RT-025, RT-026)
# -----------------------------------------------------------------------------

config ZPLC_RETAIN_PERSIST
    bool "Persist the RETAIN region across power cycles"
    default y if NVS
    depends on ZPLC_SCHED_HIGH_PRIO_WORKQ
    help
      Restores the RETAIN region when a program is loaded or restored at boot,
      before the first scan, and stores it on STOP and periodically while the
      program runs. A record carries a checksum, a layout hash and the program
      identity, two records alternate, and a record is restored only when both
      the identity and the layout match; otherwise the region is initialised and
      the status says why. The stores go through zplc_hal_persist_*, so this
      needs a working persistence backend (CONFIG_NVS on the boards of this
      repository).

      Periodic saves run on the normal-priority scheduler work queue, never in
      the scan batch and never with the memory lock held. Whether a flash write
      stalls the scan depends on the flash driver and has not been measured on
      any board: see docs/docs/runtime/persistence.md.

if ZPLC_RETAIN_PERSIST

config ZPLC_RETAIN_SAVE_INTERVAL_S
    int "Minimum interval between periodic RETAIN saves (seconds)"
    default 3600
    range 0 86400
    help
      A running program stores its RETAIN region at most once per interval, and
      only when the region changed. 0 turns periodic saves off: only STOP stores.

      The build fails when this interval wears the storage flash out before
      ZPLC_RETAIN_LIFE_YEARS, using ZPLC_RETAIN_FLASH_ENDURANCE_CYCLES and
      ZPLC_RETAIN_FLASH_WEAR_BYTES. The default is deliberately long: a board
      states its own numbers in its board file to earn a shorter interval.

config ZPLC_RETAIN_FLASH_ENDURANCE_CYCLES
    int "Erase cycles per sector the storage flash is rated for"
    default 10000
    range 100 1000000000
    help
      From the datasheet of the part that holds the storage partition. This is
      an engineering input, not a measurement, and the default is the lowest
      class of NOR flash.

config ZPLC_RETAIN_FLASH_WEAR_BYTES
    int "Bytes the storage partition absorbs per erase cycle of all its sectors"
    default 40000
    range 1024 1000000000
    help
      (sectors - 1) * sector size, minus the live data that garbage collection
      copies at every rotation (the two program slots, about 8300 bytes). One
      sector is always kept free for garbage collection.

config ZPLC_RETAIN_ENTRY_OVERHEAD
    int "Backend bytes per stored chunk beyond the data"
    default 64
    range 0 4096
    help
      Entry header and alignment of one chunk: 8 bytes for the NVS allocation
      entry, a data CRC if enabled, and the padding to the flash write block.
      The default covers a 32-byte write block.

config ZPLC_RETAIN_LIFE_YEARS
    int "Flash life the save interval must reach (years)"
    default 10
    range 1 50

config ZPLC_RETAIN_CHUNK_SIZE
    int "Largest RETAIN chunk stored under one key (bytes)"
    default 1024
    range 128 4096
    help
      The RETAIN record is cut into chunks of this size. A chunk plus the
      backend overhead must fit one erase sector minus four allocation entries
      (the NVS limit): 1024 fits a 4 KB sector. The region needs at most eight
      chunks.

endif # ZPLC_RETAIN_PERSIST

endif # ZPLC_SCHEDULER

# -----------------------------------------------------------------------------
# HIL Debug Configuration
# -----------------------------------------------------------------------------

config ZPLC_HIL_DEBUG
    bool "Enable HIL Debugging"
    default n
    help
      Enables Hardware-in-the-Loop debugging features.
      Adds JSON trace output for VM introspection and testing.
      When enabled, the runtime emits structured JSON debug frames
      over serial for automated testing and validation.

endif # ZPLC
