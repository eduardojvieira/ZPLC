/* An ADC emulator with two channels and a 3.3 V internal reference for the analog inputs of the description. */
/ {
    adc: adc_emul {
        compatible = "zephyr,adc-emul";
        nchannels = <2>;
        ref-internal-mv = <3300>;
        #io-channel-cells = <1>;
        status = "okay";
    };
};
