{
  "runs": [
    { "pattern": "packages/zplc-compiler/**/*.test.ts", "job": "typescript", "command": "bun run test:compiler" },
    { "pattern": "packages/zplc-ide/**/*.test.{ts,tsx}", "job": "typescript", "command": "bun run test:ide" },
    { "pattern": "tools/ci/**/*.test.ts", "job": "typescript", "command": "bun test ./tools/ci" },
    { "pattern": "tools/docs/**/*.test.ts", "job": "typescript", "command": "bun test ./tools/docs" },
    { "pattern": "tools/history/**/*.test.ts", "job": "typescript", "command": "bun test ./tools/history" },
    { "pattern": "scripts/release-artifacts.test.mjs", "job": "typescript", "command": "node --test scripts/release-artifacts.test.mjs" },
    { "pattern": "scripts/workflow-action-pins.test.mjs", "job": "typescript", "command": "node --test scripts/workflow-action-pins.test.mjs" },
    { "pattern": "scripts/release-version.test.ts", "job": "typescript", "command": "bun test scripts/release-version.test.ts" },
    { "pattern": "scripts/release/*.test.ts", "job": "typescript", "command": "bun test ./scripts/release" },
    { "pattern": "tools/contract/test_contract.py", "job": "docs-and-truth", "command": "bun run contract:check" },
    { "pattern": "tools/contract/*.test.ts", "job": "docs-and-truth", "command": "bun run contract:check" },
    { "pattern": "tools/contract/test_protocol.py", "job": "docs-and-truth", "command": "bun run contract:check" },
    { "pattern": "tools/hil/test_hil_*.py", "job": "typescript", "command": "python3 -B -m unittest discover -s tools/hil -p 'test_hil_*.py'" },
    { "pattern": "tools/hil/emulator/test_*.py", "job": "typescript", "command": "bun test ./tools/ci" },
    { "pattern": "tools/test_crc32_cross.py", "job": "typescript", "command": "python3 -B tools/test_crc32_cross.py" },
    { "pattern": "packages/zplc-hil/tests/**/*.test.ts", "job": "typescript", "command": "bun test packages/zplc-hil" },
    { "pattern": "tools/hil/test_validate_release_evidence.py", "job": "docs-and-truth", "command": "python3 tools/hil/test_validate_release_evidence.py" },
    { "pattern": "tools/hil/test_validate_supported_boards.py", "job": "docs-and-truth", "command": "python3 tools/hil/test_validate_supported_boards.py" },
    { "pattern": "tools/hil/test_board_io_description.py", "job": "docs-and-truth", "command": "python3 tools/hil/test_board_io_description.py" },
    { "pattern": "tools/hil/test_io_table_generator.py", "job": "docs-and-truth", "command": "python3 tools/hil/test_io_table_generator.py" },
    { "pattern": "tools/ci/test_check_hal_contract.py", "job": "docs-and-truth", "command": "python3 tools/ci/test_check_hal_contract.py" },
    { "pattern": "tools/docs/test_generate_known_limits.py", "job": "docs-and-truth", "command": "python3 tools/docs/test_generate_known_limits.py" },
    { "pattern": "tools/docs/test_*.py", "job": "docs-and-truth", "command": "python3 tools/docs/test_validate_docs_pages.py" },
    { "pattern": "firmware/lib/zplc_core/tests/fuzz_*.c", "job": "host-core-sanitized", "command": "tools/fuzz/run.sh" },
    { "pattern": "firmware/lib/zplc_core/tests/*.c", "job": "host-core", "command": "ctest --test-dir" },
    { "pattern": "firmware/lib/zplc_core/src/hal/freertos/tests/*.c", "job": "freertos-port", "command": "tools/freertos/test.sh" },
    { "pattern": "firmware/tests/**/*.c", "job": "zephyr-twister", "command": "west twister -T zplc/firmware/tests" },
    { "pattern": "tools/ci/test_run_clang_tidy.py", "job": "host-core-sanitized", "command": "python3 tools/ci/test_run_clang_tidy.py" },
    { "pattern": "tools/firmware-test/test_*.py", "job": "zephyr-twister", "command": "python3 zplc/tools/firmware-test/test_fwtest.py" },
    { "pattern": "firmware/tests/app_shell_identity/test_*.py", "job": "zephyr-twister", "command": "firmware/tests/app_shell_identity/test_app_shell_identity.py" },
    { "pattern": "firmware/tests/app_device_link/test_*.py", "job": "zephyr-twister", "command": "firmware/tests/app_device_link/test_app_device_link.py" }
  ],
  "notRunInCi": [
    { "pattern": "tools/hil/test_*.py", "requirement": "HIL-004", "reason": "device scripts that need a connected board, which CI cannot run; tools/hil/test_hil_scripts.py runs each against fake devices and shows that it exits non-zero when a check fails" },
    { "pattern": "firmware/app/tests/*.c", "requirement": "VF-022", "reason": "host test that needs nanopb and the protobuf files of a Zephyr board build; tools/firmware-test/run.sh app runs it on a developer machine, but no CI job builds a board and then runs it yet" }
  ]
}
