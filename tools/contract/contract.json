{
  "$comment": "Single source of the ZPLC binary contract (VF-012, WP-11). Edit this file and run `python3 tools/contract/generate.py`; never edit a generated file. `generate.py --check` fails when a generated file differs from a fresh generation.",
  "schema": 1,
  "abi": {
    "versionMajor": 1,
    "versionMinor": 0,
    "doc": "ISA and container version. The one final version integer of CMP-052 is assigned and frozen when the conformance matrix is closed; until then the draft counter below is what the loader and Studio compare.",
    "draftCounter": 2,
    "draftDoc": "Draft contract counter (CMP-052).\n\nIncreases by one with every change of an opcode, layout, size or code until the contract freeze. The compiler writes it in header word 28 of every artifact and the loader refuses an artifact whose counter differs from this value (ZPLC_LOADER_ERR_DRAFT). 0 is what an artifact built before the counter carries and is never accepted."
  },
  "container": {
    "magic": {
      "value": "0x434C505A",
      "doc": "Magic number for .zplc files.\n\nWhen stored in little-endian format and viewed in a hex dump,\nthe bytes read: 5A 50 4C 43 = \"ZPLC\" in ASCII.\n\nOn little-endian systems: uint32_t magic = 0x434C505A\nMemory layout: [0x5A][0x50][0x4C][0x43] = \"ZPLC\""
    },
    "crc": {"offset": 12, "size": 4, "polynomial": "0xEDB88320", "doc": "CRC32 (IEEE 802.3) over the whole file except the 4 bytes of the crc32 field."},
    "maxTasks": {"value": 16, "doc": "Artifact-wide v1 admission limit for TASK segment entries (loader)."},
