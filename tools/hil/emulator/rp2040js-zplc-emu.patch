diff --git i/src/peripherals/ppb.ts w/src/peripherals/ppb.ts
index 917252e..80dc165 100644
--- i/src/peripherals/ppb.ts
+++ w/src/peripherals/ppb.ts
@@ -57,6 +57,11 @@ export class RPPPB extends BasePeripheral implements Peripheral {
     this.systickCountFlag = true;
     if (this.systickIntEnable) {
       this.rp2040.core.pendingSystick = true;
+      // zplc-emu patch: a pending SysTick must end WFI, as an NVIC interrupt does in setInterrupt()
+      const core = this.rp2040.core;
+      if (core.waiting && core.checkForInterrupts()) {
+        core.waiting = false;
+      }
       this.rp2040.core.interruptsUpdated = true;
     }
     this.systickTimer.set(this.systickReload);
@@ -240,7 +245,9 @@ export class RPPPB extends BasePeripheral implements Peripheral {
         this.systickTimer.enable = value & (1 << 0) ? true : false;
         return;
       case SYST_CVR:
-        this.systickTimer.set(0);
+        // zplc-emu patch: on Cortex-M a write clears the counter and the next tick reloads from RVR
+        // without setting COUNTFLAG or pending the interrupt; set(0) here fired a spurious SysTick.
+        this.systickTimer.set(this.systickReload);
         return;
       case SYST_RVR:
         this.systickReload = value;
