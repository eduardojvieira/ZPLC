            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": {
              "id": "coil_led_set",
              "type": "coil_set",
              "variable": "LED_Output",
              "row": 0,
              "col": 7
            },
            "hasWire": true
          }
        ]
      ],
      "branches": []
    },
    {
      "id": "rung_4",
      "number": 4,
      "comment": "OnTimer done - RESET the LED (OFF phase starts); RESET is last, so it wins",
      "gridConfig": {
        "cols": 8,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "id": "on_done",
              "type": "contact_no",
              "variable": "OnTimer.Q",
              "row": 0,
