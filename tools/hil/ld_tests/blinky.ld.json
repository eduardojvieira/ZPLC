{
  "name": "Blinky",
  "description": "ZPLC Blinky - Ladder Diagram, two timers and SET/RESET coils (50% duty)",
  "version": "3.0.0",
  "variables": {
    "local": [
      {
        "name": "OffTimer",
        "type": "TON",
        "comment": "Times the OFF half period (runs while the LED is OFF)"
      },
      {
        "name": "OnTimer",
        "type": "TON",
        "comment": "Times the ON half period (runs while the LED is ON)"
      }
    ],
    "outputs": [
      {
        "name": "LED_Output",
        "type": "BOOL",
        "address": "%Q0.0",
        "comment": "Physical LED output"
      }
    ]
  },
  "rungs": [
    {
      "id": "rung_1",
      "number": 1,
      "comment": "OFF phase - OffTimer runs while the LED is OFF and times 500 ms",
      "gridConfig": {
        "cols": 8,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "id": "nc_led_off",
              "type": "contact_nc",
              "variable": "LED_Output",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": {
              "id": "ton_off",
              "type": "function_block",
              "fbType": "TON",
              "instance": "OffTimer",
              "parameters": {
                "IN": "CONNECTED",
                "PT": "T#500ms"
              },
              "row": 0,
              "col": 7
            },
            "hasWire": true
          }
        ]
      ],
      "branches": []
    },
    {
      "id": "rung_2",
      "number": 2,
      "comment": "ON phase - OnTimer runs while the LED is ON and times 500 ms",
      "gridConfig": {
        "cols": 8,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "id": "no_led_on",
              "type": "contact_no",
              "variable": "LED_Output",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": {
              "id": "ton_on",
              "type": "function_block",
              "fbType": "TON",
              "instance": "OnTimer",
              "parameters": {
                "IN": "CONNECTED",
                "PT": "T#500ms"
              },
              "row": 0,
              "col": 7
            },
            "hasWire": true
          }
        ]
      ],
      "branches": []
    },
    {
      "id": "rung_3",
      "number": 3,
      "comment": "OffTimer done - SET the LED (ON phase starts)",
      "gridConfig": {
        "cols": 8,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "id": "off_done",
              "type": "contact_no",
              "variable": "OffTimer.Q",
              "row": 0,
