{
  "$comment": "The record every hardware run writes (HIL-009). A small subset of JSON Schema that tools/hil/hil_record.py and packages/zplc-hil/src/record.ts both read: type, const, enum, pattern, required, properties, additionalProperties, items, minItems, minLength, minimum. Fields the firmware cannot report yet (REL-023 build information) are optional and may be null: a record then says that it does not know, it does not guess.",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "kind",
    "evidence",
    "evidence_level",
    "result",
    "started_at",
    "ended_at",
    "board",
    "device",
    "firmware",
    "tools",
    "operator",
    "steps",
    "tests",
    "logs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "zplc.hil.run-record/1"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "kind": {
      "enum": ["chain", "scenario", "script"]
    },
    "evidence": {
      "enum": ["hardware", "emulated", "host-runtime", "fake"],
      "$comment": "What ran: hardware only for a run through a serial link to a board a person handles (the human bench); emulated for a run on an emulator bench. A run on the host runtime or a fake is a test of the harness and is never evidence for a board."
    },
    "evidence_level": {
      "enum": ["hardware", "emulated", "community-reported", null],
      "$comment": "The evidence level of the HIL contract. Only hardware feeds a board's support level; emulated never does. It follows `evidence` (hil_record.py and record.ts check the pairing): a hardware run is hardware (or community-reported), an emulated run is emulated, and a run on the host runtime or a fake has no level (null)."
    },
    "emulator": {
      "type": "object",
      "required": ["name", "version", "patch_sha256"],
      "additionalProperties": false,
      "$comment": "Required on an emulated record and absent on any other: the emulator and the version or patch it ran.",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "patch_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "result": {
      "enum": ["pass", "fail", "incomplete"]
    },
    "started_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "ended_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
    },
    "board": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "zephyr_board": {
          "type": ["string", "null"]
        },
        "board_id": {
          "type": ["string", "null"],
          "$comment": "board_id of boards.json: the id the evidence records of the manifest name"
        },
        "io": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "$comment": "what boards.json says the board has: the hash of its description and the channel counts",
          "properties": {
            "hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}$"
            },
            "channels": {
              "type": "integer",
              "minimum": 0
            },
            "digital_inputs": {
              "type": "integer",
              "minimum": 0
            },
            "digital_outputs": {
              "type": "integer",
              "minimum": 0
            },
            "analog_inputs": {
              "type": "integer",
              "minimum": 0
            },
            "analog_outputs": {
              "type": "integer",
              "minimum": 0
            },
            "input_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "output_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "device": {
      "type": "object",
      "required": ["reported_board"],
      "additionalProperties": false,
      "properties": {
        "reported_board": {
          "type": "string",
          "minLength": 1
        },
        "board_profile": {
          "type": ["string", "null"]
        },
        "zplc_version": {
          "type": ["string", "null"]
        },
        "zephyr_version": {
          "type": ["string", "null"]
        },
        "serial_hash": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$",
          "$comment": "SHA-256 of vid:pid:serial number of the USB device, so that a record names a unit without publishing its serial number."
        },
        "link": {
          "enum": ["serial", "host-runtime", "fake"]
        },
        "io": {
          "type": "object",
          "required": ["board_id", "hash", "channels", "input_bytes", "output_bytes"],
          "additionalProperties": false,
          "$comment": "`zplc sys io --json` (IO-004): the board I/O description the image was built from",
          "properties": {
            "board_id": {
              "type": "string",
              "minLength": 1
            },
            "hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}$"
            },
            "channels": {
              "type": "integer",
              "minimum": 0
            },
            "input_bytes": {
              "type": "integer",
              "minimum": 0
            },
            "output_bytes": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "firmware": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "As the image reports them with `zplc sys build --json` (REL-023: version, commit, dirty, board, abi_major, abi_minor, draft_counter, options_hash, options) and as the person who flashed it says. All optional: an image that does not report its build gives null, and a value that is absent was not known, not assumed.",
      "properties": {
        "commit": {
          "type": ["string", "null"]
        },
        "version": {
          "type": ["string", "null"]
        },
        "image_sha256": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{64}$"
        },
        "abi_major": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "abi_minor": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "draft_counter": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "build_options": {
          "type": ["object", "null"]
        },
        "dirty": {
          "type": ["boolean", "null"]
        },
        "board_target": {
          "type": ["string", "null"],
          "$comment": "the `board` of the identity: CONFIG_BOARD_TARGET of a Zephyr image, the name of the host runtime otherwise"
        },
        "options_hash": {
          "type": ["string", "null"],
          "pattern": "^[0-9a-f]{8}$"
        },
        "options": {
          "type": ["string", "null"],
          "$comment": "the options text of the identity: sorted SYMBOL=value pairs of the CONFIG_ZPLC_* symbols without that prefix"
        },
        "hil_trace": {
          "type": ["boolean", "null"],
          "$comment": "whether the image was built with CONFIG_ZPLC_HIL_DEBUG, read from the options; null when the options cannot say"
        },
        "build_command": {
          "type": ["string", "null"],
          "$comment": "the build command the chain told the person to run for the image under test; the tool cannot see what was run, and the options hash is how the image is told apart"
        }
      }
    },
    "programs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "sha256"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "scenario": {
      "type": "object",
      "required": ["id", "sha256"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "tolerance_ms": {
          "type": "number",
          "minimum": 0,
          "description": "A lateness bound: a tick is sampled once the device clock has reached it, never earlier, and the run is void when a sample is later than this. Assertion windows are not widened by it."
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commit": {
          "type": ["string", "null"]
        },
        "dirty": {
          "type": ["boolean", "null"]
        }
      }
    },
    "tools": {
      "type": "object",
      "required": ["harness", "platform"],
      "additionalProperties": false,
      "properties": {
        "harness": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "python": {
          "type": ["string", "null"]
        },
        "bun": {
          "type": ["string", "null"]
        },
        "compiler_draft_counter": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "operator": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "kind", "result"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": ["automatic", "physical"]
          },
          "result": {
            "enum": ["pass", "fail", "error", "skipped", "pending", "not-emulable"]
          },
          "requirement": {
            "type": ["string", "null"]
          },
          "started_at": {
            "type": "string"
          },
          "ended_at": {
            "type": "string"
          },
          "confirmed_at": {
            "type": "string",
            "$comment": "When a person confirmed a physical step by typing the identity the device reported."
          },
          "confirmed_identity": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          },
          "measurements": {
            "type": "object"
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "result"],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string"
          },
          "result": {
            "enum": ["pass", "fail", "skipped"]
          },
          "detail": {
            "type": "string"
          }
        }
      }
    },
    "measurements": {
      "type": "object"
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requirement": {
          "type": "string"
        },
        "done": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pending": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "logs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "text"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "text": {
            "type": "string"
          }
        }
      }
    }
  }
}
