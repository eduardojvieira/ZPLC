            "element": null,
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_3",
      "number": 3,
      "comment": "Proportional inlet: 800 percent per metre of error, limited to 0 to 100 percent.",
      "branches": [],
      "gridConfig": {
        "cols": 8,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "id": "r3_0_0",
              "type": "function",
              "functionName": "SUB",
              "operands": ["SetM", "LevelM"],
              "output": "Err",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": {
              "id": "r3_0_1",
              "type": "function",
              "functionName": "MUL",
              "operands": ["800.0", "Err"],
              "output": "FillCmd",
              "row": 0,
              "col": 1
            },
            "hasWire": true
          },
          {
            "element": {
              "id": "r3_0_2",
              "type": "function",
              "functionName": "LIMIT",
              "operands": ["0.0", "FillCmd", "100.0"],
              "output": "FillCmd",
              "row": 0,
              "col": 2
            },
            "hasWire": true
          },
          {
            "element": null,
