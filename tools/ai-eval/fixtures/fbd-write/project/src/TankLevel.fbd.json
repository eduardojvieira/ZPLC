        "type": "REAL",
        "address": "%QD1",
        "comment": "Tank1.drain: 0 to 100 percent of the discharge valve"
      },
      {
        "name": "LevelShown",
        "type": "REAL",
        "address": "%QD2",
        "comment": "LevelDisplay.value: the level in m"
      },
      {
        "name": "Green",
        "type": "BOOL",
        "address": "%QX12.0",
        "comment": "StackLight1.green: the level is within 5 percent of the set point"
      }
    ]
  },
