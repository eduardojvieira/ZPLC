        "name": "LevelRawR",
        "type": "REAL",
        "comment": "Raw level as a REAL"
      },
      {
        "name": "SetPointRawR",
        "type": "REAL",
        "comment": "Raw set point as a REAL"
      },
      {
        "name": "DrainRawR",
        "type": "REAL",
        "comment": "Raw drain opening as a REAL"
      }
    ],
    "inputs": [
      {
        "name": "LevelRaw",
        "type": "INT",
        "address": "%IW0",
        "comment": "Tank1.level: 0 to 27648 is 0 to 1 m"
      },
      {
        "name": "SetPointRaw",
        "type": "INT",
        "address": "%IW1",
        "comment": "SetPoint.value: 0 to 1000 is 0 to 1 m"
      },
      {
        "name": "DrainRaw",
        "type": "INT",
        "address": "%IW2",
        "comment": "DrainPot.value: 0 to 1000 is 0 to 100 percent"
