      { "atMs": 19000, "operate": { "signal": "ReleaseButton.pressed", "value": true } },
      { "atMs": 19200, "operate": { "signal": "ReleaseButton.pressed", "value": false } },
      { "atMs": 22000, "operate": { "signal": "ReleaseButton.pressed", "value": true } },
      { "atMs": 22200, "operate": { "signal": "ReleaseButton.pressed", "value": false } },
      { "atMs": 25000, "operate": { "signal": "ReleaseButton.pressed", "value": true } },
      { "atMs": 25200, "operate": { "signal": "ReleaseButton.pressed", "value": false } },
      { "atMs": 28000, "operate": { "signal": "ReleaseButton.pressed", "value": true } },
      { "atMs": 28200, "operate": { "signal": "ReleaseButton.pressed", "value": false } }
