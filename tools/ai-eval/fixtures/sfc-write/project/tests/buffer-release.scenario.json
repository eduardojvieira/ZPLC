    {
      "kind": "EVENTUALLY",
      "fromMs": 0,
      "withinMs": 36000,
      "condition": { "fact:emitted:Emitter1": true, "fact:delivered:Remover1": true }
    },
    { "kind": "ALWAYS", "condition": { "BufferRelease.Fault": false, "fact:itemsDropped": false, "fact:itemsCollided": false } }
