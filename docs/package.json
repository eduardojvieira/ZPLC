{
  "name": "website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "generate:runtime-reference": "python3 ../tools/docs/generate_runtime_reference.py",
    "generate:board-reference": "python3 ../tools/docs/generate_board_reference.py",
    "generate:known-limits": "python3 ../tools/docs/generate_known_limits.py",
    "generate:function-reference": "bun ../tools/docs/generate_function_reference.ts",
    "generate:source-references": "bun ../tools/docs/generate_source_references.ts",
    "generate:language-reference": "bun ../tools/docs/generate_language_reference.ts",
    "generate:keyboard-reference": "bun ../tools/docs/generate_keyboard_reference.ts",
    "generate:diagnostic-codes": "bun ../tools/docs/generate_diagnostic_codes.ts",
    "generate:port-interface": "bun ../tools/docs/generate_port_interface.ts",
    "generate:docs": "bun run generate:runtime-reference && bun run generate:board-reference && bun run generate:known-limits && bun run generate:function-reference && bun run generate:source-references && bun run generate:language-reference && bun run generate:keyboard-reference && bun run generate:diagnostic-codes && bun run generate:port-interface",
    "validate:docs": "python3 ../tools/hil/validate_docs_parity.py",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
    "@docusaurus/core": "3.9.2",
    "@docusaurus/preset-classic": "3.9.2",
    "@docusaurus/theme-mermaid": "3.9.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "esp-web-tools": "10.4.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.9.2",
    "@docusaurus/types": "3.9.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  }
}
