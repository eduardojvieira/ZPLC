{
  "printWidth": 140,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "proseWrap": "preserve",
  "endOfLine": "lf",
  "overrides": [
    {
      "files": "packages/zplc-compiler/**/*.ts",
      "options": {
        "tabWidth": 4
      }
    },
    {
      "files": "docs/**/*.md",
      "options": {
        "parser": "mdx"
      }
    }
  ]
}
