# Build directories, at any depth: build/, build_*/ (build_posix, build_pico, build_tests, ...),
# build-*/, cmake-build-*/, and the Twister and distribution outputs.
build/
build_*/
build-*/
cmake-build-*/
bin/
dist/
/twister-out*/

# Root workspace
node_modules/
bun.lock
!bun.lock
/.worktrees/

# Packages
packages/*/node_modules/
packages/*/dist/
packages/*/electron-dist/
packages/*/.env
packages/*/.DS_Store
packages/zplc-ide/dist-native/

# HIL local credentials (never commit)
tools/hil/.env
tools/hil/*.env

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/
*.swp

# LSP/clangd (symlink to build/compile_commands.json - local to each dev)
compile_commands.json
.cache/clangd/

# Python files
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Compiled ZPLC files
*.zplc
!examples/*.zplc
!tools/fuzz/findings/*.zplc

# Third-party agent skills installed for local use are not part of the repository;
# the project skill zplc-plc-programmer is.
/.agents/skills/*
!/.agents/skills/zplc-plc-programmer/
/.claude/skills/*

# Local artifacts
Screenshots/
*.bak
.gemini/
.agent/
.opencode/
task.md
walkthrough.md
implementation_plan.md
task_boundary_history.json
packages/zplc-ide/.impeccable/
# *.png  <-- COMENTADO PARA PERMITIR IMÁGENES
*.webp
*.video
*.audio
*.mp4
*.mkv
*.webm
*.mov
*.wav
*.mp3
*.m4a
*.log

# Temp files
*.tmp
temp/
.cache/
coverage/
out/
obj/
.env*

build_wasm/

# Generated by Docusaurus build
sitemap.xml
docs/build/
docs/.docusaurus/
