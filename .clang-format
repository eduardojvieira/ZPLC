# VF-017: the C style of the core (LLVM base, two spaces, attached braces) at the repository line limit of 140.
# clang-format output changes between versions: CI and contributors use the pinned wheel in tools/ci/clang-format-version.txt.
BasedOnStyle: LLVM
ColumnLimit: 140
# Comments and includes are hand-written: the formatter must not re-wrap or reorder them.
ReflowComments: Never
SortIncludes: Never
AlignEscapedNewlines: Left
