{
  "requirement": "CMP-058",
  "title": "CTUD counts below 0 and back up, QU and QD by signed comparison",
  "matrix": ["blocks.ctu-ctd-ctud"],
  "note": "IEC 61131-3 CTUD: CD edges take CV from 0 to -1 and -2 (QD TRUE: CV <= 0), QU is CV >= PV with PV = -1 (TRUE at 0 and -1, FALSE at -2), and CU edges bring it back to -1 and 0",
  "scans": 8,
  "scanMs": 10,
  "inputs": [
    {"at": "%IX0.1", "type": "BOOL", "value": true, "beforeScan": 1},
    {"at": "%IX0.1", "type": "BOOL", "value": false, "beforeScan": 2},
    {"at": "%IX0.1", "type": "BOOL", "value": true, "beforeScan": 3},
    {"at": "%IX0.1", "type": "BOOL", "value": false, "beforeScan": 4},
    {"at": "%IX0.0", "type": "BOOL", "value": true, "beforeScan": 5},
    {"at": "%IX0.0", "type": "BOOL", "value": false, "beforeScan": 6},
    {"at": "%IX0.0", "type": "BOOL", "value": true, "beforeScan": 7},
    {"at": "%IX0.0", "type": "BOOL", "value": false, "beforeScan": 8}
  ],
  "expect": [
    {"at": "%QW1", "type": "INT", "value": -1, "afterScan": 1},
    {"at": "%QX0.0", "type": "BOOL", "value": true, "afterScan": 1},
    {"at": "%QX0.1", "type": "BOOL", "value": true, "afterScan": 1},
    {"at": "%QW1", "type": "INT", "value": -2, "afterScan": 3},
    {"at": "%QX0.0", "type": "BOOL", "value": false, "afterScan": 3},
    {"at": "%QX0.1", "type": "BOOL", "value": true, "afterScan": 3},
    {"at": "%QW1", "type": "INT", "value": -1, "afterScan": 5},
    {"at": "%QX0.0", "type": "BOOL", "value": true, "afterScan": 5},
    {"at": "%QW1", "type": "INT", "value": 0, "afterScan": 7},
    {"at": "%QX0.0", "type": "BOOL", "value": true, "afterScan": 7},
    {"at": "%QX0.1", "type": "BOOL", "value": true, "afterScan": 7}
  ]
}
