{
  "requirement": "CMP-058",
  "title": "CTD counts a pulse that rises on the scan Load is released",
  "matrix": ["blocks.ctu-ctd-ctud"],
  "note": "IEC 61131-3 CTD: a rising edge of CD counts down while CV > PVmin (-32768), so the counter that was never loaded goes from 0 to -1 on the first scan; the load at scan 2 and the edge on the scan it is released (3 - 1 = 2) are the point of the case",
  "scans": 4,
  "scanMs": 10,
  "inputs": [
    { "at": "%IX0.0", "type": "BOOL", "value": true, "beforeScan": 1 },
    { "at": "%IX0.1", "type": "BOOL", "value": true, "beforeScan": 2 },
    { "at": "%IX0.0", "type": "BOOL", "value": false, "beforeScan": 3 },
    { "at": "%IX0.0", "type": "BOOL", "value": true, "beforeScan": 4 },
    { "at": "%IX0.1", "type": "BOOL", "value": false, "beforeScan": 4 }
  ],
  "expect": [
    { "at": "%QW1", "type": "INT", "value": -1, "afterScan": 1 },
    { "at": "%QX0.0", "type": "BOOL", "value": true, "afterScan": 1 },
    { "at": "%QW1", "type": "INT", "value": 3, "afterScan": 2 },
    { "at": "%QX0.0", "type": "BOOL", "value": false, "afterScan": 2 },
    { "at": "%QW1", "type": "INT", "value": 3, "afterScan": 3 },
    { "at": "%QX0.0", "type": "BOOL", "value": false, "afterScan": 3 },
    { "at": "%QW1", "type": "INT", "value": 2, "afterScan": 4 },
    { "at": "%QX0.0", "type": "BOOL", "value": false, "afterScan": 4 }
  ]
}
