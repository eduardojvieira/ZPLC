    { "at": "%ID0", "type": "REAL", "value": 2.5, "beforeScan": 3 },
    { "at": "%ID0", "type": "REAL", "value": 4.0, "beforeScan": 4 }
  ],
  "expect": [
    { "at": "%QD0", "type": "REAL", "value": 0.0, "afterScan": 1 },
    { "at": "%QD0", "type": "REAL", "value": 2.0, "afterScan": 2 },
    { "at": "%QD0", "type": "REAL", "value": 2.0, "afterScan": 3 },
    { "at": "%QD0", "type": "REAL", "value": 4.0, "afterScan": 4 }
  ]
}
