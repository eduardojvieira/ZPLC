  "matrix": ["blocks.library-blocks-not-in-the-standard"],
  "note": "Not an IEC block: the contract is the documented one of stdlib/process.ts: the output follows IN only when IN differs from the last output by more than WIDTH",
  "scans": 4,
  "scanMs": 10,
  "inputs": [
    { "at": "%ID0", "type": "REAL", "value": 0.5, "beforeScan": 1 },
