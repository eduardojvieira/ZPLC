    {"at": "%ID0", "type": "REAL", "value": -7.0, "beforeScan": 3},
    {"at": "%ID0", "type": "REAL", "value": -6.5, "beforeScan": 4}
  ],
  "expect": [
    {"at": "%QD0", "type": "REAL", "value": -5.0, "afterScan": 1},
    {"at": "%QD0", "type": "REAL", "value": -5.0, "afterScan": 2},
    {"at": "%QD0", "type": "REAL", "value": -7.0, "afterScan": 3},
    {"at": "%QD0", "type": "REAL", "value": -7.0, "afterScan": 4}
  ]
}
