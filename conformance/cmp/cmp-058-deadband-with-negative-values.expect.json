{
  "requirement": "CMP-058",
  "title": "DEADBAND follows a negative input only when it moves by more than WIDTH",
  "matrix": ["blocks.library-blocks-not-in-the-standard"],
  "tags": ["arch-sensitive", "float"],
  "note": "Not an IEC block: the output follows IN only when IN differs from the last output by more than WIDTH; from 0 the input -5 moves it, -5.5 does not, -7 does and -6.5 does not",
