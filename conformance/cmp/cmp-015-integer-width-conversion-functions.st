PROGRAM WidthConversions
VAR
  n1 AT %QD0 : DINT;
  n2 AT %QD1 : UDINT;
  n3 AT %QW600 : INT;
  n4 AT %QB1024 : BYTE;
  w1 AT %QD2 : LINT;
  w2 AT %QD4 : LINT;
  w3 AT %QD6 : ULINT;
  w4 AT %QD8 : LWORD;
  w5 AT %QD10 : ULINT;
  w6 AT %QD12 : LINT;
  b1 AT %QX512.0 : BOOL;
  b2 AT %QX512.1 : BOOL;
  b3 AT %QX512.2 : BOOL;
  r1 AT %QD14 : LREAL;
END_VAR
  n1 := LINT_TO_DINT(5000000000);
  n2 := ULINT_TO_UDINT(18446744073709551615);
  n3 := LINT_TO_INT(-4294967297);
  n4 := LWORD_TO_BYTE(16#1234567890ABCDEF);
  w1 := DINT_TO_LINT(-1);
  w2 := UDINT_TO_LINT(4294967295);
  w3 := DINT_TO_ULINT(-1);
  w4 := BYTE_TO_LWORD(200);
  w5 := LINT_TO_ULINT(-1);
  w6 := ULINT_TO_LINT(18446744073709551615);
  b1 := LINT_TO_BOOL(0);
  b2 := LINT_TO_BOOL(4294967296);
  b3 := LWORD_TO_BOOL(16#8000000000000000);
  r1 := LINT_TO_LREAL(-1);
END_PROGRAM
