FUNCTION_BLOCK Base
METHOD Value : INT
  Value := 1;
END_METHOD
END_FUNCTION_BLOCK

FUNCTION_BLOCK Middle EXTENDS Base
METHOD OVERRIDE Value : INT
  Value := SUPER^.Value() + 10;
END_METHOD
END_FUNCTION_BLOCK

FUNCTION_BLOCK Top EXTENDS Middle
METHOD OVERRIDE Value : INT
  Value := SUPER^.Value() + 100;
END_METHOD
END_FUNCTION_BLOCK

PROGRAM Chain
VAR
  t : Top;
  seen AT %QW0 : INT;
END_VAR
  seen := t.Value();
END_PROGRAM
