FUNCTION_BLOCK ABSTRACT Template
METHOD ABSTRACT Step : INT
END_METHOD
METHOD Run : INT
  Run := Step() * 2 + 1;
END_METHOD
END_FUNCTION_BLOCK

FUNCTION_BLOCK Seven EXTENDS Template
METHOD OVERRIDE Step : INT
  Step := 7;
END_METHOD
END_FUNCTION_BLOCK

FUNCTION_BLOCK Nine EXTENDS Template
METHOD OVERRIDE Step : INT
  Step := 9;
END_METHOD
END_FUNCTION_BLOCK

PROGRAM Abstraction
VAR
  a : Seven;
  b : Nine;
  x AT %QW0 : INT;
  y AT %QW1 : INT;
END_VAR
  x := a.Run();
  y := b.Run();
END_PROGRAM
