FUNCTION_BLOCK Base
METHOD A : INT
  A := 1;
END_METHOD
METHOD B : INT
  B := 10;
END_METHOD
END_FUNCTION_BLOCK

FUNCTION_BLOCK Derived EXTENDS Base
METHOD OVERRIDE B : INT
  B := 20;
END_METHOD
END_FUNCTION_BLOCK

PROGRAM Inheritance
VAR
  d : Derived;
  x AT %QW0 : INT;
  y AT %QW1 : INT;
END_VAR
  x := d.A();
  y := d.B();
END_PROGRAM
