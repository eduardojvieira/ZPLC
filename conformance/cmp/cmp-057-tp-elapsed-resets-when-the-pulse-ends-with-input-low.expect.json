{
  "requirement": "CMP-057",
  "title": "TP elapsed time is 0 when the pulse ends while IN is false",
  "matrix": ["blocks.tp"],
  "note": "IEC 61131-3, the TP timing diagram: IN is TRUE for the first scan only; the pulse runs for PT = 30 ms whatever IN does, and when it ends with IN already FALSE the elapsed time is back at 0",
  "scans": 5,
  "scanMs": 10,
  "inputs": [
    {"at": "%IX0.0", "type": "BOOL", "value": true, "beforeScan": 1},
    {"at": "%IX0.0", "type": "BOOL", "value": false, "beforeScan": 2}
  ],
  "expect": [
    {"at": "%QX0.0", "type": "BOOL", "value": true, "afterScan": 3},
    {"at": "%QD1", "type": "DINT", "value": 20, "afterScan": 3},
    {"at": "%QX0.0", "type": "BOOL", "value": false, "afterScan": 4},
    {"at": "%QD1", "type": "DINT", "value": 0, "afterScan": 4},
    {"at": "%QX0.0", "type": "BOOL", "value": false, "afterScan": 5},
    {"at": "%QD1", "type": "DINT", "value": 0, "afterScan": 5}
  ]
}
