{
  "requirement": "CMP-057",
  "title": "TP holds Q for the preset when IN falls, and ends it at the preset",
  "matrix": ["blocks.tp"],
  "note": "IEC 61131-3, the TP timer (timing diagram): a rising edge of IN sets Q for the time PT whatever IN does meanwhile; the input rises at 10 ms and falls at 20 ms, so Q is TRUE until 60 ms, where the elapsed time equals PT",
  "scans": 8,
  "scanMs": 10,
  "inputs": [
    { "at": "%IX0.0", "type": "BOOL", "value": true, "beforeScan": 2 },
    { "at": "%IX0.0", "type": "BOOL", "value": false, "beforeScan": 3 }
  ],
  "expect": [
    { "at": "%QX0.0", "type": "BOOL", "value": false, "afterScan": 1 },
    { "at": "%QX0.0", "type": "BOOL", "value": true, "afterScan": 2 },
    { "at": "%QX0.0", "type": "BOOL", "value": true, "afterScan": 3 },
    { "at": "%QX0.0", "type": "BOOL", "value": true, "afterScan": 6 },
    { "at": "%QX0.0", "type": "BOOL", "value": false, "afterScan": 7 },
    { "at": "%QX0.0", "type": "BOOL", "value": false, "afterScan": 8 }
  ]
}
