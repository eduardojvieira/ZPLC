{
  "name": "BottleBatch",
  "description": "A bottle-capping station that runs a conveyor for a batch of four bottles, lights BatchDone at four, and resets on ResetBatch.",
  "version": "1.0.0",
  "variables": {
    "local": [
      {
        "name": "BatchRun",
        "type": "BOOL",
        "comment": "Memory: the batch has been started"
      },
      {
        "name": "Bottles",
        "type": "CTU",
        "comment": "Counts the bottles passing the capping sensor"
      },
      {
        "name": "BatchFull",
        "type": "BOOL",
        "comment": "Bottles.Q: four bottles have been counted"
      }
    ],
    "inputs": [
      {
        "name": "CycleStart",
        "type": "BOOL",
        "comment": "Push button: starts the batch"
      },
      {
        "name": "CapSensor",
        "type": "BOOL",
        "comment": "Optical sensor: TRUE while a bottle is under the capper"
      },
      {
        "name": "ResetBatch",
        "type": "BOOL",
        "comment": "Push button: clears the batch memory and counter"
      }
    ],
    "outputs": [
      {
        "name": "Conveyor",
        "type": "BOOL",
        "comment": "Conveyor motor"
      },
      {
        "name": "BatchDone",
        "type": "BOOL",
        "comment": "Indicator lamp: lit when four bottles have passed"
      }
    ]
  },
  "rungs": [
    {
      "id": "rung_1",
      "number": 1,
      "comment": "CycleStart latches the batch memory.",
      "branches": [],
      "gridConfig": {
        "cols": 8,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "id": "r1_0_0",
              "type": "contact_no",
              "variable": "CycleStart",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
