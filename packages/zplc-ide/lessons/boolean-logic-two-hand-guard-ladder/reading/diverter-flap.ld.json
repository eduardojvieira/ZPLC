{
  "name": "DiverterFlap",
  "description": "A conveyor flap that pushes tall boxes into a side lane unless the lane is full, and a fault lamp when the flap does not follow its command while the belt runs.",
  "version": "1.0.0",
  "variables": {
    "local": [
      {
        "name": "TallBox",
        "type": "BOOL",
        "comment": "Height eye: TRUE while a tall box passes"
      },
      {
        "name": "LaneFull",
        "type": "BOOL",
        "comment": "Lane switch: TRUE while the side lane is full"
      },
      {
        "name": "FlapIsOut",
        "type": "BOOL",
        "comment": "Flap position switch: TRUE while the flap is out"
      },
      {
        "name": "BeltRunning",
        "type": "BOOL",
        "comment": "TRUE while the belt runs"
      }
    ],
    "outputs": [
      {
        "name": "Flap",
        "type": "BOOL",
        "address": "%Q0.0",
        "comment": "Flap command"
      },
      {
        "name": "FlapFault",
        "type": "BOOL",
        "address": "%Q0.1",
        "comment": "Flap fault lamp"
      }
    ]
  },
  "rungs": [
    {
      "id": "rung_1",
      "number": 1,
      "comment": "AND with NOT: the flap swings out for a tall box while the lane is not full.",
      "branches": [],
      "gridConfig": {
        "cols": 8,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "id": "e0_0_1",
              "type": "contact_no",
              "variable": "TallBox",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": {
              "id": "e0_1_1",
              "type": "contact_nc",
              "variable": "LaneFull",
              "row": 0,
              "col": 1
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": {
              "id": "e0_7_1",
              "type": "coil",
              "variable": "Flap",
              "row": 0,
              "col": 7
            },
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_2",
      "number": 2,
      "comment": "Exclusive-or in series: the command and the position differ, and the belt runs.",
      "branches": [
        {
          "id": "branch_1",
          "startCol": 0,
          "endCol": 1,
          "rows": [0, 1]
        }
      ],
      "gridConfig": {
        "cols": 8,
        "rows": 2,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "id": "e0_0_2",
              "type": "contact_no",
              "variable": "Flap",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": {
              "id": "e0_1_2",
              "type": "contact_nc",
              "variable": "FlapIsOut",
              "row": 0,
              "col": 1
            },
            "hasWire": true
