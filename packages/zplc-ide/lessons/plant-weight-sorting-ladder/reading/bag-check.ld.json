{
  "name": "BagCheck",
  "description": "A scale under a bag filler: the bag is judged only while the scale says it has settled.",
  "version": "1.0.0",
  "variables": {
    "local": [
      {
        "name": "Net",
        "type": "DINT",
        "initialValue": 0,
        "comment": "Grams in the bag"
      }
    ],
    "inputs": [
      {
        "name": "Scoop",
        "type": "BOOL",
        "comment": "Filler pushbutton: one press drops 100 grams into the bag"
      },
      {
        "name": "NewBag",
        "type": "BOOL",
        "comment": "Pushbutton: an empty bag is put on the scale"
      },
      {
        "name": "Settled",
        "type": "BOOL",
        "comment": "Scale: the bag has been at rest long enough to be weighed"
      }
    ],
    "outputs": [
      {
        "name": "Short",
        "type": "BOOL",
        "comment": "Lamp: the settled bag holds less than 500 grams"
      },
      {
        "name": "Pass",
        "type": "BOOL",
        "comment": "Lamp: the settled bag holds at least 500 grams"
      }
    ]
  },
  "rungs": [
    {
      "id": "rung_1",
      "number": 1,
      "comment": "One press of Scoop is one pulse: the box adds 100 grams to the bag once and keeps the result.",
      "branches": [],
      "gridConfig": {
        "cols": 6,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "type": "contact_p",
              "variable": "Scoop",
              "id": "r1_0",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": {
              "type": "function",
              "functionName": "ADD",
              "operands": ["Net", "100"],
              "output": "Net",
              "id": "r1_1",
              "row": 0,
              "col": 1
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_2",
      "number": 2,
      "comment": "One press of NewBag empties the bag.",
      "branches": [],
      "gridConfig": {
        "cols": 6,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "type": "contact_p",
              "variable": "NewBag",
              "id": "r2_0",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": {
              "type": "function",
              "functionName": "MOVE",
              "operands": ["0"],
              "output": "Net",
              "id": "r2_1",
              "row": 0,
              "col": 1
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_3",
      "number": 3,
      "comment": "Two conditions in series: the bag has settled and Net is below 500. The coil is on only while both hold.",
      "branches": [],
      "gridConfig": {
        "cols": 6,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "type": "contact_no",
              "variable": "Settled",
              "id": "r3_0",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": {
              "type": "function",
              "functionName": "LT",
              "operands": ["Net", "500"],
              "id": "r3_1",
              "row": 0,
              "col": 1
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": {
              "type": "coil",
              "variable": "Short",
              "id": "r3_5",
              "row": 0,
              "col": 5
            },
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_4",
      "number": 4,
      "comment": "The same two conditions with the other side of the limit: a bag of exactly 500 grams passes.",
      "branches": [],
      "gridConfig": {
        "cols": 6,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "type": "contact_no",
              "variable": "Settled",
              "id": "r4_0",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": {
              "type": "function",
              "functionName": "GE",
              "operands": ["Net", "500"],
              "id": "r4_1",
              "row": 0,
              "col": 1
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": {
              "type": "coil",
              "variable": "Pass",
              "id": "r4_5",
              "row": 0,
              "col": 5
            },
            "hasWire": true
          }
        ]
      ]
    }
  ],
  "metadata": {
    "author": "ZPLC Team",
    "created": "2026-11-28",
    "iecStandard": "IEC 61131-3",
    "notes": []
  }
}
