{
  "name": "DipHoist",
  "description": "A single-axis dipping hoist sequenced with an INT state variable, EQ comparisons, MOVE boxes, and limit feedback.",
  "version": "1.0.0",
  "variables": {
    "local": [
      {
        "name": "Step",
        "type": "INT",
        "initialValue": 0,
        "comment": "0 idle, 1 lock hook, 2 lower, 3 soak, 4 lift, 5 unlock"
      },
      {
        "name": "Soak",
        "type": "TON",
        "comment": "Times how long the part stays in the quench tank"
      }
    ],
    "inputs": [
      {
        "name": "PartReady",
        "type": "BOOL",
        "comment": "A part hangs on the hook ready to dip"
      },
      {
        "name": "Locked",
        "type": "BOOL",
        "comment": "Hook latch closed feedback"
      },
      {
        "name": "Bottom",
        "type": "BOOL",
        "comment": "Hoist at bottom limit"
      },
      {
        "name": "Top",
        "type": "BOOL",
        "comment": "Hoist at top limit"
      }
    ],
    "outputs": [
      {
        "name": "Lock",
        "type": "BOOL",
        "comment": "Close the hook latch while true"
      },
      {
        "name": "GoDown",
        "type": "BOOL",
        "comment": "Lower the hoist while true"
      },
      {
        "name": "GoUp",
        "type": "BOOL",
        "comment": "Lift the hoist while true"
      }
    ]
  },
