{
  "name": "ParkingLot",
  "description": "A sign that lights when four cars have entered.",
  "version": "1.0.0",
  "variables": {
    "local": [
      {
        "name": "Cars",
        "type": "CTU",
        "comment": "Up counter: Cars.CV is the number of cars so far"
      }
    ],
    "inputs": [
      {
        "name": "CarSensor",
        "type": "BOOL",
        "comment": "Entry sensor: TRUE while a car is on the loop"
      },
      {
        "name": "Attendant",
        "type": "BOOL",
        "comment": "Attendant reset button: TRUE while pressed"
      }
    ],
    "outputs": [
      {
        "name": "FullSign",
        "type": "BOOL",
        "comment": "Lot full sign"
      }
    ]
  },
  "rungs": [
    {
      "id": "rung_1",
      "number": 1,
      "comment": "Each car adds one; the sign lights at four; the attendant clears the count.",
      "branches": [],
      "gridConfig": {
        "cols": 8,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "id": "no_CarSensor_00",
              "type": "contact_no",
              "variable": "CarSensor",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": {
              "id": "fb_Cars",
              "type": "function_block",
              "fbType": "CTU",
              "instance": "Cars",
              "parameters": {
                "CU": "CONNECTED",
                "R": "Attendant",
                "PV": "4"
              },
              "row": 0,
              "col": 6
            },
            "hasWire": true
          },
          {
            "element": {
              "id": "coil_FullSign_07",
              "type": "coil",
              "variable": "FullSign",
              "row": 0,
              "col": 7
            },
            "hasWire": true
          }
        ]
      ]
    }
  ],
  "metadata": {
    "author": "ZPLC Team",
    "created": "2026-11-05",
    "iecStandard": "IEC 61131-3",
    "notes": []
  }
}
