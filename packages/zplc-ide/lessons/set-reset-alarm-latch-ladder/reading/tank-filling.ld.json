{
  "name": "TankFilling",
  "description": "A filling cycle that a button starts with a SET coil and that a full tank or a stop button ends with a RESET coil written last.",
  "version": "1.0.0",
  "variables": {
    "local": [
      {
        "name": "FillButton",
        "type": "BOOL",
        "comment": "Fill push button: TRUE while pressed"
      },
      {
        "name": "StopButton",
        "type": "BOOL",
        "comment": "Stop push button: TRUE while pressed"
      },
      {
        "name": "TankFull",
        "type": "BOOL",
        "comment": "Float switch: TRUE while the tank is full"
      }
    ],
    "outputs": [
      {
        "name": "FillValve",
        "type": "BOOL",
        "address": "%Q0.0",
        "comment": "Fill valve, open while the filling cycle runs"
      }
    ]
  },
  "rungs": [
    {
      "id": "rung_1",
      "number": 1,
      "comment": "A press of the fill button starts the cycle, unless the tank is already full.",
      "branches": [],
      "gridConfig": {
        "cols": 8,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "id": "e0_0_1",
              "type": "contact_no",
              "variable": "FillButton",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": {
              "id": "e0_1_1",
              "type": "contact_nc",
              "variable": "TankFull",
              "row": 0,
              "col": 1
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": {
              "id": "e0_7_1",
              "type": "coil_set",
              "variable": "FillValve",
              "row": 0,
              "col": 7
            },
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_2",
      "number": 2,
      "comment": "A full tank or the stop button ends the cycle. This RESET rung is last, so it wins.",
      "branches": [
        {
          "id": "branch_1",
          "startCol": 0,
          "endCol": 0,
          "rows": [0, 1]
        }
      ],
      "gridConfig": {
        "cols": 8,
        "rows": 2,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "id": "e0_0_2",
