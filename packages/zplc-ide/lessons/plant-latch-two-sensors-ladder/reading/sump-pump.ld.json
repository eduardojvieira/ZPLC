{
  "name": "SumpPump",
  "description": "A sump pump latched directly between a high-level switch and a low-level switch, with high-level priority.",
  "version": "1.0.0",
  "variables": {
    "local": [],
    "inputs": [
      {
        "name": "HighLevel",
        "type": "BOOL",
        "comment": "High float switch: TRUE when water reaches the top of the pit"
      },
      {
        "name": "LowLevel",
        "type": "BOOL",
        "comment": "Low float switch: TRUE while water is above the bottom, FALSE when empty"
      }
    ],
    "outputs": [
      {
        "name": "Pump",
        "type": "BOOL",
        "comment": "Drain pump: runs until the pit is empty"
      }
    ]
  },
  "rungs": [
    {
      "id": "rung_1",
      "number": 1,
      "comment": "When water falls below LowLevel, reset the pump.",
      "branches": [],
      "gridConfig": {
        "cols": 8,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "id": "r1_0_0",
              "type": "contact_nc",
              "variable": "LowLevel",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
