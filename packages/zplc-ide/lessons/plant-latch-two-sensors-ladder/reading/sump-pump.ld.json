            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": {
              "id": "r1_0_7",
              "type": "coil_reset",
              "variable": "Pump",
              "row": 0,
              "col": 7
            },
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_2",
      "number": 2,
      "comment": "When water reaches HighLevel, set the pump. Last rung wins against a failed low switch.",
      "branches": [],
      "gridConfig": {
        "cols": 8,
