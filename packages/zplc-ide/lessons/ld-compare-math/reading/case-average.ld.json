            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_6",
      "number": 6,
      "comment": "Heavy while the average is above 300 g.",
      "branches": [],
      "gridConfig": {
        "cols": 6,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
