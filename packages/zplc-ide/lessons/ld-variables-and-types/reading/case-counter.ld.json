{
  "name": "CaseCounter",
  "description": "A counter whose preset is an INT variable.",
  "version": "1.0.0",
  "variables": {
    "local": [
      {
        "name": "Count",
        "type": "CTU",
        "comment": "Up counter"
      },
      {
        "name": "BatchSize",
        "type": "INT",
        "initialValue": 3,
        "comment": "Bottles in one case: a whole number"
      }
    ],
    "inputs": [
      {
        "name": "Bottle",
        "type": "BOOL",
        "comment": "Bottle sensor: TRUE while a bottle passes"
      },
      {
        "name": "NewCase",
        "type": "BOOL",
        "comment": "New case pushbutton: TRUE while pressed"
      }
    ],
    "outputs": [
      {
        "name": "CaseFull",
        "type": "BOOL",
        "comment": "TRUE when the case holds BatchSize bottles"
      }
    ]
  },
