{
  "name": "ValveLatch",
  "description": "A valve that opens with one button and closes with another.",
  "version": "1.0.0",
  "variables": {
    "local": [
      {
        "name": "OpenButton",
        "type": "BOOL",
        "comment": "Push button: TRUE while pressed"
