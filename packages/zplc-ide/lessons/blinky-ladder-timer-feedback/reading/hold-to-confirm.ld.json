{
  "name": "HoldToConfirm",
  "description": "A lamp that lights only after the button has been held for two seconds.",
  "version": "1.0.0",
  "variables": {
    "local": [
      {
        "name": "HoldButton",
        "type": "BOOL",
        "comment": "Push button: TRUE while pressed"
      },
