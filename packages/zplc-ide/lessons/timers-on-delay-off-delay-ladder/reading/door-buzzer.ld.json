{
  "name": "DoorBuzzer",
  "description": "A buzzer that sounds only after a door has been open for two seconds.",
  "version": "1.0.0",
  "variables": {
    "local": [
      {
        "name": "BuzzTimer",
        "type": "TON",
        "comment": "On-delay timer: waits before the buzzer"
      }
    ],
    "inputs": [
      {
        "name": "DoorOpen",
        "type": "BOOL",
        "comment": "Door switch: TRUE while the door is open"
      }
    ],
    "outputs": [
      {
        "name": "Buzzer",
        "type": "BOOL",
        "comment": "Door-open buzzer"
      }
    ]
  },
  "rungs": [
    {
      "id": "rung_1",
      "number": 1,
      "comment": "TON: the buzzer turns on only after DoorOpen has stayed on for PT.",
      "branches": [],
      "gridConfig": {
        "cols": 8,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "id": "no_DoorOpen_00",
              "type": "contact_no",
              "variable": "DoorOpen",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": {
              "id": "fb_BuzzTimer",
              "type": "function_block",
              "fbType": "TON",
              "instance": "BuzzTimer",
              "parameters": {
                "IN": "CONNECTED",
                "PT": "T#2s"
              },
              "row": 0,
              "col": 6
            },
            "hasWire": true
          },
          {
            "element": {
              "id": "coil_Buzzer_07",
              "type": "coil",
              "variable": "Buzzer",
              "row": 0,
              "col": 7
            },
            "hasWire": true
          }
        ]
      ]
    }
  ],
  "metadata": {
    "author": "ZPLC Team",
    "created": "2026-11-05",
    "iecStandard": "IEC 61131-3",
    "notes": []
  }
}
