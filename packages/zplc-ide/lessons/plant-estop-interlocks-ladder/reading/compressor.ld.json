{
  "name": "Compressor",
  "description": "An air compressor that stays off after an over-temperature until the cool-enough switch says it may run again.",
  "version": "1.0.0",
  "variables": {
    "local": [
      {
        "name": "Cooling",
        "type": "BOOL",
        "comment": "Memory: the motor is held off while the compressor is too hot"
      }
    ],
    "inputs": [
      {
        "name": "Demand",
        "type": "BOOL",
        "comment": "Pressure switch: TRUE while the tank asks for air"
      },
      {
        "name": "TooHot",
        "type": "BOOL",
        "comment": "High-temperature switch: TRUE while the motor is too hot"
      },
      {
        "name": "CoolEnough",
        "type": "BOOL",
        "comment": "Low-temperature switch: TRUE once the motor has cooled enough"
      }
    ],
    "outputs": [
      {
        "name": "Motor",
        "type": "BOOL",
        "comment": "Compressor motor"
      }
    ]
  },
  "rungs": [
    {
      "id": "rung_1",
      "number": 1,
      "comment": "The high-temperature switch sets the memory.",
      "branches": [],
      "gridConfig": {
        "cols": 8,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
