{
  "name": "PumpCommand",
  "description": "A pump speed setpoint in rpm scaled to the counts of an analog output for its drive.",
  "version": "1.0.0",
  "variables": {
    "local": [
      {
        "name": "Ups",
        "type": "DINT",
        "initialValue": 0,
        "comment": "Speed added by SpeedUp so far, in rpm"
      },
      {
        "name": "Downs",
        "type": "DINT",
        "initialValue": 0,
        "comment": "Speed taken away by SpeedDown so far, in rpm"
      },
      {
        "name": "Wanted",
        "type": "DINT",
        "initialValue": 0,
        "comment": "The speed asked for, before the limit"
      },
      {
        "name": "Rpm",
        "type": "DINT",
        "initialValue": 0,
        "comment": "Pump speed setpoint in rpm, 0..3000"
      },
      {
        "name": "Scaled",
        "type": "DINT",
        "initialValue": 0,
        "comment": "Rpm times 4095: 12 285 000 at full speed, far above what an INT holds"
      },
      {
        "name": "Command",
        "type": "DINT",
        "initialValue": 0,
        "comment": "The analog command for the drive in counts, 0..4095"
      }
    ],
    "inputs": [
      {
        "name": "SpeedUp",
        "type": "BOOL",
        "comment": "One press adds 500 rpm"
      },
      {
        "name": "SpeedDown",
        "type": "BOOL",
        "comment": "One press takes away 500 rpm"
      }
    ],
    "outputs": [
      {
        "name": "DriveOn",
        "type": "BOOL",
        "comment": "Lamp: the command is above zero"
      },
      {
        "name": "FullCommand",
        "type": "BOOL",
        "comment": "Lamp: the command is at 4095 counts"
      }
    ]
  },
  "rungs": [
    {
      "id": "rung_1",
      "number": 1,
      "comment": "One press of SpeedUp is one pulse that adds 500 rpm.",
      "branches": [],
      "gridConfig": {
        "cols": 6,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "type": "contact_p",
              "variable": "SpeedUp",
              "id": "r1_0",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": {
              "type": "function",
              "functionName": "ADD",
              "operands": ["Ups", "500"],
              "output": "Ups",
              "id": "r1_1",
              "row": 0,
              "col": 1
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_2",
      "number": 2,
      "comment": "One press of SpeedDown takes 500 rpm away.",
      "branches": [],
      "gridConfig": {
        "cols": 6,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "type": "contact_p",
              "variable": "SpeedDown",
              "id": "r2_0",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": {
              "type": "function",
              "functionName": "ADD",
              "operands": ["Downs", "500"],
              "output": "Downs",
              "id": "r2_1",
              "row": 0,
              "col": 1
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_3",
      "number": 3,
      "comment": "The wanted speed is what went up minus what went down.",
      "branches": [],
      "gridConfig": {
        "cols": 6,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "type": "function",
              "functionName": "SUB",
              "operands": ["Ups", "Downs"],
              "output": "Wanted",
              "id": "r3_0",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_4",
      "number": 4,
      "comment": "LIMIT keeps the setpoint inside the range of the pump, 0..3000 rpm.",
      "branches": [],
      "gridConfig": {
        "cols": 6,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "type": "function",
              "functionName": "LIMIT",
              "operands": ["0", "Wanted", "3000"],
              "output": "Rpm",
              "id": "r4_0",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_5",
      "number": 5,
      "comment": "Speed to counts for the drive: multiply by the span of the counts, then divide by the span of the speed.",
      "branches": [],
      "gridConfig": {
        "cols": 6,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "type": "function",
              "functionName": "MUL",
              "operands": ["Rpm", "4095"],
              "output": "Scaled",
              "id": "r5_0",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": {
              "type": "function",
              "functionName": "DIV",
              "operands": ["Scaled", "3000"],
              "output": "Command",
              "id": "r5_1",
              "row": 0,
              "col": 1
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_6",
      "number": 6,
      "comment": "DriveOn while the command is above zero.",
      "branches": [],
      "gridConfig": {
        "cols": 6,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "type": "function",
              "functionName": "GT",
              "operands": ["Command", "0"],
              "id": "r6_0",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": {
              "type": "coil",
              "variable": "DriveOn",
              "id": "r6_5",
              "row": 0,
              "col": 5
            },
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_7",
      "number": 7,
      "comment": "FullCommand at the top of the range of the drive.",
      "branches": [],
      "gridConfig": {
        "cols": 6,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "type": "function",
              "functionName": "GE",
              "operands": ["Command", "4095"],
              "id": "r7_0",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": null,
