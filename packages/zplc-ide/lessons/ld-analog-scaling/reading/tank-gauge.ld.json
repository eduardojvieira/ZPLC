{
  "name": "TankGauge",
  "description": "A level sensor in counts, scaled to millimetres, with a warning and a high lamp.",
  "version": "1.0.0",
  "variables": {
    "local": [
      {
        "name": "Ups",
        "type": "DINT",
        "initialValue": 0,
        "comment": "Counts added by the knob so far"
      },
      {
        "name": "Downs",
        "type": "DINT",
        "initialValue": 0,
        "comment": "Counts taken away by the knob so far"
      },
      {
        "name": "Knob",
        "type": "DINT",
        "initialValue": 0,
        "comment": "Stand-in for the sensor before the limit"
      },
      {
        "name": "Raw",
        "type": "DINT",
        "initialValue": 0,
        "comment": "The analog input in counts, 0..4095"
      },
      {
        "name": "Scaled",
        "type": "DINT",
        "initialValue": 0,
        "comment": "Raw times 2000: 8 190 000 at full scale, far above what an INT holds"
      },
      {
        "name": "Mm",
        "type": "DINT",
        "initialValue": 0,
        "comment": "Level in millimetres, 0..2000"
      }
    ],
    "inputs": [
      {
        "name": "TurnUp",
        "type": "BOOL",
        "comment": "Knob up: one press adds 512 counts"
      },
      {
        "name": "TurnDown",
        "type": "BOOL",
        "comment": "Knob down: one press takes away 512 counts"
      }
    ],
    "outputs": [
      {
        "name": "Warn",
        "type": "BOOL",
        "comment": "Lamp: 1000 mm or more"
      },
      {
        "name": "High",
        "type": "BOOL",
        "comment": "Lamp: more than 1500 mm"
      }
    ]
  },
  "rungs": [
    {
      "id": "rung_1",
      "number": 1,
      "comment": "One press of TurnUp is one pulse that adds 512 counts.",
      "branches": [],
      "gridConfig": {
        "cols": 6,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "type": "contact_p",
              "variable": "TurnUp",
              "id": "r1_0",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": {
              "type": "function",
              "functionName": "ADD",
              "operands": ["Ups", "512"],
              "output": "Ups",
              "id": "r1_1",
              "row": 0,
              "col": 1
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_2",
      "number": 2,
      "comment": "One press of TurnDown takes 512 counts away.",
      "branches": [],
      "gridConfig": {
        "cols": 6,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "type": "contact_p",
              "variable": "TurnDown",
              "id": "r2_0",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": {
              "type": "function",
              "functionName": "ADD",
              "operands": ["Downs", "512"],
              "output": "Downs",
              "id": "r2_1",
              "row": 0,
              "col": 1
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_3",
      "number": 3,
      "comment": "The knob position is what went up minus what went down.",
      "branches": [],
      "gridConfig": {
        "cols": 6,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "type": "function",
              "functionName": "SUB",
              "operands": ["Ups", "Downs"],
              "output": "Knob",
              "id": "r3_0",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_4",
      "number": 4,
      "comment": "LIMIT keeps the counts inside the range of a 12-bit input.",
      "branches": [],
      "gridConfig": {
        "cols": 6,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "type": "function",
              "functionName": "LIMIT",
              "operands": ["0", "Knob", "4095"],
              "output": "Raw",
              "id": "r4_0",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_5",
      "number": 5,
      "comment": "Counts to millimetres: multiply by the span of the tank, then divide by the span of the counts.",
      "branches": [],
      "gridConfig": {
        "cols": 6,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "type": "function",
              "functionName": "MUL",
              "operands": ["Raw", "2000"],
              "output": "Scaled",
              "id": "r5_0",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": {
              "type": "function",
              "functionName": "DIV",
              "operands": ["Scaled", "4095"],
              "output": "Mm",
              "id": "r5_1",
              "row": 0,
              "col": 1
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_6",
      "number": 6,
      "comment": "Warning from 1000 mm.",
      "branches": [],
      "gridConfig": {
        "cols": 6,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "type": "function",
              "functionName": "GE",
              "operands": ["Mm", "1000"],
              "id": "r6_0",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
