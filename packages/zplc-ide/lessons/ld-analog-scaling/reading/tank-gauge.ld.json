            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": {
              "type": "coil",
              "variable": "Warn",
              "id": "r6_5",
              "row": 0,
              "col": 5
            },
            "hasWire": true
          }
