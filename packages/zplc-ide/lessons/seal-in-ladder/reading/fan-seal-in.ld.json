        "type": "BOOL",
        "comment": "Off push button: TRUE while pressed"
      },
      {
        "name": "Overload",
        "type": "BOOL",
        "comment": "Overload relay: TRUE when tripped"
      }
    ],
    "outputs": [
      {
        "name": "Fan",
