{
  "name": "LaggingOrder",
  "description": "A part sensor passes through a memory bit to a horn, with the rungs in the wrong order.",
  "version": "1.0.0",
  "variables": {
    "local": [
      {
        "name": "PartSensor",
        "type": "BOOL",
        "comment": "Part sensor: TRUE while a part is in front of it"
      },
      {
        "name": "PartSeen",
        "type": "BOOL",
        "initialValue": false,
        "comment": "Memory bit that follows the part sensor"
      }
    ],
    "outputs": [
      {
        "name": "Horn",
        "type": "BOOL",
        "address": "%Q0.0",
        "comment": "Horn"
      }
    ]
  },
  "rungs": [
    {
      "id": "rung_1",
      "number": 1,
      "comment": "The horn rung runs first, so it sees PartSeen as it was at the end of the previous scan.",
