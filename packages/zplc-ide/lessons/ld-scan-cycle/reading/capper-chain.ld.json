{
  "name": "CapperChain",
  "description": "A bottle sensor passes through two memory bits to a capping head, with every rung above the rung that writes what it reads.",
  "version": "1.0.0",
  "variables": {
    "local": [
      {
        "name": "BottleHere",
        "type": "BOOL",
        "comment": "Bottle sensor: TRUE while a bottle is under the capping head"
      },
      {
        "name": "BottleSeen",
        "type": "BOOL",
        "initialValue": false,
        "comment": "Memory bit that follows the bottle sensor"
      },
      {
        "name": "CapReady",
        "type": "BOOL",
        "initialValue": false,
        "comment": "Memory bit that follows BottleSeen"
      }
    ],
    "outputs": [
      {
        "name": "Capper",
        "type": "BOOL",
        "address": "%Q0.0",
        "comment": "Capping head"
      }
    ]
  },
