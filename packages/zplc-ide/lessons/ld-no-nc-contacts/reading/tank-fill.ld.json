{
  "name": "TankFill",
  "description": "A fill valve that opens on request until a float switch says the tank is full, and a lamp that shows a full tank.",
  "version": "1.0.0",
  "variables": {
    "local": [
      {
        "name": "FillRequest",
        "type": "BOOL",
        "comment": "Fill selector: TRUE while the operator asks for water"
      },
      {
        "name": "TankFull",
        "type": "BOOL",
        "comment": "Float switch: TRUE while the water reaches it"
      }
    ],
    "outputs": [
      {
        "name": "FillValve",
        "type": "BOOL",
        "address": "%Q0.0",
        "comment": "Fill valve"
      },
      {
        "name": "FullLamp",
        "type": "BOOL",
        "address": "%Q0.1",
        "comment": "Lamp that shows a full tank"
      }
    ]
  },
  "rungs": [
    {
      "id": "rung_1",
      "number": 1,
      "comment": "The valve opens on request while the tank is not full: the normally closed contact conducts while TankFull is FALSE.",
