{
  "name": "ScrapBelt",
  "description": "A scrap conveyor where a short press starts clearing until empty, and holding the button jogs the belt even when empty.",
  "version": "1.0.0",
  "variables": {
    "local": [
      {
        "name": "Clearing",
        "type": "BOOL",
        "comment": "Memory: the scrap belt should be running"
      }
    ],
    "inputs": [
      {
        "name": "ClearBelt",
        "type": "BOOL",
        "comment": "Push button: starts clearing and jogs while held"
      },
      {
        "name": "BeltEmpty",
        "type": "BOOL",
        "comment": "Light curtain: TRUE when no offcuts remain on the belt"
      }
    ],
    "outputs": [
      {
        "name": "Motor",
        "type": "BOOL",
        "comment": "Scrap belt motor"
      }
    ]
  },
