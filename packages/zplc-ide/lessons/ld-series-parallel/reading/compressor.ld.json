{
  "name": "Compressor",
  "description": "An air compressor that runs from a switch until the pressure is high, and an alarm lamp for high pressure or low oil.",
  "version": "1.0.0",
  "variables": {
    "local": [
      {
        "name": "RunSwitch",
        "type": "BOOL",
        "comment": "Run switch: TRUE while switched on"
      },
      {
        "name": "HighPressure",
        "type": "BOOL",
        "comment": "Pressure switch: TRUE while the tank pressure is too high"
      },
      {
        "name": "OilOK",
        "type": "BOOL",
        "comment": "Oil level switch: TRUE while there is enough oil"
      }
    ],
    "outputs": [
      {
        "name": "Compressor",
        "type": "BOOL",
        "address": "%Q0.0",
        "comment": "Compressor motor"
      },
      {
        "name": "AlarmLamp",
        "type": "BOOL",
        "address": "%Q0.1",
        "comment": "Alarm lamp"
      }
    ]
  },
  "rungs": [
    {
      "id": "rung_1",
      "number": 1,
      "comment": "Series: the compressor runs with the switch on AND the pressure not too high.",
      "branches": [],
      "gridConfig": {
        "cols": 8,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "id": "e0_0_1",
              "type": "contact_no",
              "variable": "RunSwitch",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": {
              "id": "e0_1_1",
              "type": "contact_nc",
              "variable": "HighPressure",
              "row": 0,
              "col": 1
            },
            "hasWire": true
          },
          {
