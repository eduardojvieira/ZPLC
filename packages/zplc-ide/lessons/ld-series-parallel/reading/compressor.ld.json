              "type": "coil",
              "variable": "Compressor",
              "row": 0,
              "col": 7
            },
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_2",
      "number": 2,
      "comment": "Parallel: the alarm lamp is lit when the pressure is too high OR the oil is not OK.",
