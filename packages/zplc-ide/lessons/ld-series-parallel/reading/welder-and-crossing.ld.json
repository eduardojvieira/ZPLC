            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": {
              "id": "e0_7_2",
              "type": "coil",
              "variable": "WalkRequest",
              "row": 0,
              "col": 7
            },
            "hasWire": true
          }
        ],
        [
          {
            "element": {
              "id": "e1_0_2",
              "type": "contact_no",
              "variable": "SouthButton",
              "row": 1,
              "col": 0
