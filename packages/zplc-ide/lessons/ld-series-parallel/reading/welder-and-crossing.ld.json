{
  "name": "WelderCrossing",
  "description": "A welder that needs a key and a closed guard, and a walk request from either of two buttons.",
  "version": "1.0.0",
  "variables": {
    "local": [
      {
        "name": "KeyTurned",
        "type": "BOOL",
        "comment": "Key switch: TRUE when turned"
      },
      {
        "name": "GuardClosed",
        "type": "BOOL",
        "comment": "Guard switch: TRUE when closed"
      },
      {
        "name": "NorthButton",
        "type": "BOOL",
        "comment": "North crossing button: TRUE while pressed"
      },
      {
        "name": "SouthButton",
        "type": "BOOL",
        "comment": "South crossing button: TRUE while pressed"
      }
    ],
    "outputs": [
      {
        "name": "Welder",
        "type": "BOOL",
        "address": "%Q0.0",
        "comment": "Welder enable"
      },
      {
        "name": "WalkRequest",
        "type": "BOOL",
        "address": "%Q0.1",
        "comment": "A pedestrian asked to cross"
      }
    ]
  },
  "rungs": [
    {
      "id": "rung_1",
      "number": 1,
      "comment": "Series: both contacts must conduct for power to reach the welder.",
      "branches": [],
      "gridConfig": {
        "cols": 8,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "id": "e0_0_1",
              "type": "contact_no",
              "variable": "KeyTurned",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": {
              "id": "e0_1_1",
              "type": "contact_no",
              "variable": "GuardClosed",
              "row": 0,
              "col": 1
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": {
              "id": "e0_7_1",
              "type": "coil",
              "variable": "Welder",
              "row": 0,
              "col": 7
            },
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_2",
      "number": 2,
      "comment": "Parallel: either button gives power a path to the coil.",
      "branches": [
        {
          "id": "branch_1",
          "startCol": 0,
          "endCol": 0,
          "rows": [0, 1]
        }
      ],
      "gridConfig": {
        "cols": 8,
        "rows": 2,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "id": "e0_0_2",
              "type": "contact_no",
              "variable": "NorthButton",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
