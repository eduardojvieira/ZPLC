{
  "name": "Weighbridge",
  "description": "Two truck lanes sharing a single-lane weighbridge: North wins when both wait, and only one green light is ever on.",
  "version": "1.0.0",
  "variables": {
    "local": [
      {
        "name": "NorthReq",
        "type": "BOOL",
        "comment": "A truck waits at the north entry gate"
      },
      {
        "name": "SouthReq",
        "type": "BOOL",
        "comment": "A truck waits at the south entry gate"
      },
      {
        "name": "BridgeBusy",
        "type": "BOOL",
        "comment": "A truck is currently on the weighbridge"
      },
      {
        "name": "WeighDone",
        "type": "BOOL",
        "comment": "Operator pulse once the truck has cleared the weighbridge"
      },
      {
        "name": "AllowNorth",
        "type": "BOOL",
        "initialValue": false,
        "comment": "Grant latch for the north lane"
      },
      {
        "name": "AllowSouth",
        "type": "BOOL",
        "initialValue": false,
        "comment": "Grant latch for the south lane"
      }
    ],
    "inputs": [],
    "outputs": [
      {
        "name": "GreenNorth",
        "type": "BOOL",
        "address": "%Q0.0",
        "comment": "Green light for the north lane"
      },
      {
        "name": "GreenSouth",
        "type": "BOOL",
        "address": "%Q0.1",
        "comment": "Green light for the south lane"
      }
    ]
  },
  "rungs": [
    {
      "id": "rung_1",
      "number": 1,
      "comment": "Priority 1: grant North when North waits, no grant is active and the bridge is free.",
      "branches": [],
      "gridConfig": {
        "cols": 8,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "id": "e0_0_1",
              "type": "contact_no",
              "variable": "NorthReq",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": {
              "id": "e0_1_1",
              "type": "contact_nc",
              "variable": "AllowNorth",
              "row": 0,
              "col": 1
            },
            "hasWire": true
          },
          {
            "element": {
              "id": "e0_2_1",
              "type": "contact_nc",
              "variable": "AllowSouth",
              "row": 0,
              "col": 2
            },
            "hasWire": true
