    "ExitBelt.run": { "direction": "command", "type": "BOOL", "point": "Assembler.RunExit" },
    "LidBlade.extend": { "direction": "command", "type": "BOOL", "point": "Assembler.HoldLid" },
    "BaseBlade.extend": { "direction": "command", "type": "BOOL", "point": "Assembler.HoldBase" },
    "LidEmitter.emit": { "direction": "command", "type": "BOOL", "point": "Assembler.EmitLid" },
    "BaseEmitter.emit": { "direction": "command", "type": "BOOL", "point": "Assembler.EmitBase" },
    "StackLight1.green": { "direction": "command", "type": "BOOL", "point": "Assembler.Green" },
    "StackLight1.amber": { "direction": "command", "type": "BOOL", "point": "Assembler.Amber" }
  }
