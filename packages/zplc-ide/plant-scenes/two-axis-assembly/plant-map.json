{
  "schemaVersion": 2,
  "target": { "scene": "two-axis-assembly" },
  "signals": {
    "StartButton.pressed": { "direction": "sensor", "type": "BOOL", "point": "Assembler.Start" },
    "LidEye.detect": { "direction": "sensor", "type": "BOOL", "point": "Assembler.LidReady" },
    "BaseEye.detect": { "direction": "sensor", "type": "BOOL", "point": "Assembler.BaseReady" },
    "Pick1.xAtMin": { "direction": "sensor", "type": "BOOL", "point": "Assembler.XAtMin" },
    "Pick1.xAtMax": { "direction": "sensor", "type": "BOOL", "point": "Assembler.XAtMax" },
    "Pick1.yAtMin": { "direction": "sensor", "type": "BOOL", "point": "Assembler.YAtMin" },
    "Pick1.yAtMax": { "direction": "sensor", "type": "BOOL", "point": "Assembler.YAtMax" },
    "Pick1.gripped": { "direction": "sensor", "type": "BOOL", "point": "Assembler.Gripped" },
    "Pick1.xPlus": { "direction": "command", "type": "BOOL", "point": "Assembler.XPlus" },
    "Pick1.xMinus": { "direction": "command", "type": "BOOL", "point": "Assembler.XMinus" },
    "Pick1.yPlus": { "direction": "command", "type": "BOOL", "point": "Assembler.YPlus" },
    "Pick1.yMinus": { "direction": "command", "type": "BOOL", "point": "Assembler.YMinus" },
    "Pick1.grip": { "direction": "command", "type": "BOOL", "point": "Assembler.Grip" },
