              "id": "fb_WarnTimer",
              "type": "function_block",
              "fbType": "TON",
              "instance": "WarnTimer",
              "parameters": {
                "IN": "CONNECTED",
                "PT": "WarnTime"
              },
              "row": 0,
              "col": 6
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          }
        ]
      ]
    },
    {
