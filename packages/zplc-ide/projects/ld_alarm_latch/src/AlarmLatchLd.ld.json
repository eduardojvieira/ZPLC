{
  "name": "AlarmLatchLd",
  "description": "Alarm latch with SET and RESET coils: the rung that comes last wins when Fault and Ack arrive together.",
  "version": "1.0.0",
  "variables": {
    "local": [],
    "inputs": [
      {
        "name": "Fault",
        "type": "BOOL",
        "address": "%I0.0",
        "comment": "Fault input: TRUE while the fault is present"
      },
      {
        "name": "Ack",
        "type": "BOOL",
        "address": "%I0.1",
        "comment": "Acknowledge pushbutton, normally open: TRUE while pressed"
      }
    ],
    "outputs": [
      {
        "name": "SetFirst",
        "type": "BOOL",
        "address": "%Q0.0",
        "comment": "Alarm latch where the last SET rung wins: set has priority"
      },
      {
        "name": "ResetFirst",
        "type": "BOOL",
        "address": "%Q0.1",
        "comment": "Alarm latch where the last RESET rung wins: reset has priority"
      }
    ]
  },
  "rungs": [
    {
      "id": "rung_1",
      "number": 1,
      "comment": "Ack drops SetFirst. This RESET rung comes before the SET rung, so SET wins when both are true.",
      "branches": [],
