{
  "name": "BeltToSensor",
  "description": "Belt to sensor: start the belt from a button and stop it when the box reaches the far sensor.",
  "version": "1.0.0",
  "variables": {
    "local": [],
    "inputs": [
      {
        "name": "Start",
        "type": "BOOL",
        "address": "%I0.0",
        "comment": "StartButton.pressed: the start button"
      },
      {
        "name": "EyeFar",
        "type": "BOOL",
        "address": "%I0.1",
        "comment": "EyeFar.detect: the sensor at the far end of the belt"
      }
    ],
    "outputs": [
      {
        "name": "Run",
        "type": "BOOL",
        "address": "%Q0.0",
        "comment": "Belt1.run: run the belt"
      },
      {
        "name": "Emit",
        "type": "BOOL",
        "address": "%Q0.1",
        "comment": "Emitter1.emit: put one box on the belt"
      }
    ]
  },
  "rungs": [
    {
      "id": "rung_1",
      "number": 1,
      "comment": "Goal: a press of the start button puts a box on the belt and runs it; the belt stops when the box reaches the far sensor. The starter only puts the box on.",
