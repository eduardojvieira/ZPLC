{
  "name": "MotorDiag",
  "description": "Motor start and stop with a seal-in, an overload trip and an alarm lamp.",
  "version": "1.0.0",
  "variables": {
    "local": [],
    "inputs": [
      {
        "name": "StartPB",
        "type": "BOOL",
        "address": "%I0.0",
        "comment": "Start pushbutton, normally open: TRUE while pressed"
      },
      {
        "name": "StopOK",
        "type": "BOOL",
        "address": "%I0.1",
        "comment": "Stop pushbutton wired normally closed: TRUE at rest, FALSE while the button is pressed"
      },
      {
        "name": "OverloadOK",
        "type": "BOOL",
        "address": "%I0.2",
        "comment": "Thermal overload relay: TRUE while the motor is healthy, FALSE when it trips"
      }
    ],
    "outputs": [
      {
        "name": "Motor",
        "type": "BOOL",
        "address": "%Q0.0",
        "comment": "Motor contactor command. It is also the memory that holds the motor on."
      },
      {
        "name": "Alarm",
        "type": "BOOL",
        "address": "%Q0.1",
        "comment": "Alarm lamp: TRUE while the overload has tripped"
      }
    ]
  },
  "rungs": [
    {
      "id": "rung_1",
      "number": 1,
      "comment": "Start / stop with seal-in. The contact on Motor holds the coil on; StopOK and OverloadOK are in series after the branch, so either one drops the motor.",
      "branches": [
        {
          "id": "branch_1",
          "startCol": 0,
          "endCol": 1,
          "rows": [0, 1]
        }
      ],
      "gridConfig": {
        "cols": 8,
        "rows": 2,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "id": "contact_no_StartPB_00",
              "type": "contact_no",
              "variable": "StartPB",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": {
              "id": "contact_no_StopOK_00",
              "type": "contact_no",
              "variable": "StopOK",
              "row": 0,
              "col": 2
            },
            "hasWire": true
          },
          {
            "element": {
              "id": "contact_no_OverloadOK_00",
              "type": "contact_no",
              "variable": "OverloadOK",
              "row": 0,
              "col": 3
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": {
              "id": "coil_Motor_07",
              "type": "coil",
              "variable": "Motor",
              "row": 0,
              "col": 7
            },
            "hasWire": true
          }
        ],
        [
          {
            "element": {
              "id": "contact_no_Motor_00",
              "type": "contact_no",
              "variable": "Motor",
              "row": 1,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": false
          },
          {
            "element": null,
            "hasWire": false
          },
          {
            "element": null,
            "hasWire": false
          },
          {
            "element": null,
            "hasWire": false
          },
          {
            "element": null,
            "hasWire": false
          },
          {
            "element": null,
            "hasWire": false
          }
        ]
      ]
    },
    {
      "id": "rung_2",
      "number": 2,
      "comment": "The alarm lamp lights while the overload relay reports a trip.",
      "branches": [],
      "gridConfig": {
        "cols": 8,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "id": "contact_nc_OverloadOK_00",
              "type": "contact_nc",
              "variable": "OverloadOK",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
