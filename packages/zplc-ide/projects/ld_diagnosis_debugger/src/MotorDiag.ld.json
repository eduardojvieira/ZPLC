          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": {
              "id": "coil_Alarm_07",
              "type": "coil",
              "variable": "Alarm",
              "row": 0,
              "col": 7
            },
            "hasWire": true
          }
        ]
      ]
    }
  ],
  "metadata": {
    "author": "ZPLC Team",
