          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": {
              "id": "coil_Light_07",
              "type": "coil",
              "variable": "Light",
              "row": 0,
              "col": 7
            },
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_2",
      "number": 2,
      "comment": "Confirmed follows Sensor. Put an on-delay timer (TON, 200 ms) between the contact and the coil.",
      "branches": [],
