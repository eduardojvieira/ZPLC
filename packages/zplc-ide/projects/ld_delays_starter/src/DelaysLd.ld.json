{
  "name": "DelaysLd",
  "description": "An off-delay keeps a light on after a button; an on-delay confirms a sensor that stays on.",
  "version": "1.0.0",
  "variables": {
    "local": [
      {
        "name": "HoldTimer",
        "type": "TOF",
        "comment": "Off-delay: keeps Light on after Button is released"
      },
      {
        "name": "FilterTimer",
        "type": "TON",
        "comment": "On-delay: confirms Sensor only after it stays on"
      }
    ],
    "inputs": [
      {
        "name": "Button",
        "type": "BOOL",
        "address": "%I0.0",
        "comment": "Button, normally open: TRUE while pressed"
      },
      {
        "name": "Sensor",
        "type": "BOOL",
        "address": "%I0.1",
        "comment": "Sensor: TRUE while it detects"
      }
    ],
    "outputs": [
      {
        "name": "Light",
        "type": "BOOL",
        "address": "%Q0.0",
        "comment": "Light that stays on after Button is released"
      },
      {
        "name": "Confirmed",
        "type": "BOOL",
        "address": "%Q0.1",
        "comment": "TRUE once Sensor has been on long enough"
      }
    ]
  },
  "rungs": [
    {
      "id": "rung_1",
      "number": 1,
      "comment": "Light follows Button. Put an off-delay timer (TOF, 300 ms) between the contact and the coil.",
      "branches": [],
      "gridConfig": {
        "cols": 8,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "id": "no_Button_00",
              "type": "contact_no",
              "variable": "Button",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
