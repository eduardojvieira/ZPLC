{
  "$schema": "../../zplc.schema.json",
  "schemaVersion": 2,
  "name": "Opta LED Chaser (Ladder)",
  "version": "1.0.0",
  "description": "Larson scanner (bouncing chaser) over the four Opta status LEDs D0-D3 (%Q0.0-%Q0.3), in Ladder Diagram",
  "target": {
    "board": "arduino_opta_wifi"
  },
  "compiler": {
    "optimization": "none",
    "debug": true
  },
  "tasks": [
    {
      "name": "ChaserTask",
      "trigger": "cyclic",
      "interval_ms": 10,
      "priority": 1,
      "programs": ["led_chaser.ld"]
    }
  ],
  "build": {
    "outDir": "build"
  }
}
