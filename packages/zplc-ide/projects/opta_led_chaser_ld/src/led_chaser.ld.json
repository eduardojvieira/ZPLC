{
  "name": "Opta_LED_Chaser",
  "description": "Larson scanner on Opta D0-D3 in Ladder: a TON tick and a one-hot shift register of six positions",
  "version": "3.0.0",
  "variables": {
    "local": [
      {
        "name": "Tick",
        "type": "BOOL",
        "initialValue": false,
        "comment": "TRUE for one scan every 150 ms + 2 scans"
      },
      {
        "name": "TimerInst",
        "type": "TON"
      },
      {
        "name": "Carry",
        "type": "BOOL",
        "initialValue": false
      },
      {
        "name": "P0",
        "type": "BOOL",
        "initialValue": true,
        "comment": "Position 0 of the 6-step bounce (D0 D1 D2 D3 D2 D1)"
      },
      {
        "name": "P1",
        "type": "BOOL",
        "initialValue": false
      },
      {
        "name": "P2",
        "type": "BOOL",
        "initialValue": false
      },
      {
        "name": "P3",
        "type": "BOOL",
        "initialValue": false
      },
      {
        "name": "P4",
        "type": "BOOL",
        "initialValue": false
      },
      {
        "name": "P5",
        "type": "BOOL",
        "initialValue": false
      }
    ],
    "inputs": [],
    "outputs": [
      {
        "name": "LED_D0",
        "type": "BOOL",
        "address": "%Q0.0"
      },
      {
        "name": "LED_D1",
        "type": "BOOL",
        "address": "%Q0.1"
      },
      {
        "name": "LED_D2",
        "type": "BOOL",
        "address": "%Q0.2"
      },
      {
        "name": "LED_D3",
        "type": "BOOL",
        "address": "%Q0.3"
      }
    ]
  },
