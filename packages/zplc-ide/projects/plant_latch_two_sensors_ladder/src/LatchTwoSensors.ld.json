{
  "name": "LatchTwoSensors",
  "description": "Run a belt from sensor A until the box reaches sensor B.",
  "version": "1.0.0",
  "variables": {
    "local": [],
    "inputs": [
      {
        "name": "EyeA",
        "type": "BOOL",
        "address": "%I0.0",
        "comment": "EyeA.detect: sensor A, where the box starts"
      },
      {
        "name": "EyeB",
        "type": "BOOL",
        "address": "%I0.1",
        "comment": "EyeB.detect: sensor B, where the box must stop"
      }
    ],
    "outputs": [
      {
        "name": "Run",
        "type": "BOOL",
        "address": "%Q0.0",
        "comment": "Belt1.run: run the belt"
      }
    ]
  },
  "rungs": [
    {
      "id": "rung_1",
      "number": 1,
      "comment": "EyeA sets Run: the output is the memory.",
      "branches": [],
      "gridConfig": {
        "cols": 8,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "id": "r1_0_0",
              "type": "contact_no",
              "variable": "EyeA",
              "row": 0,
              "col": 0
            },
            "hasWire": true
