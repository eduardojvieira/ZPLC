{
  "name": "NcStop",
  "description": "Starter: both rungs read StopButton with the wrong kind of contact.",
  "version": "1.0.0",
  "variables": {
    "local": [],
    "inputs": [
      {
        "name": "StartButton",
        "type": "BOOL",
        "address": "%I0.0",
        "comment": "Start pushbutton, normally open: TRUE while pressed"
      },
      {
        "name": "StopButton",
        "type": "BOOL",
        "address": "%I0.1",
        "comment": "Stop pushbutton wired normally closed in the field: TRUE at rest, FALSE when pressed or when the wire breaks"
      }
    ],
    "outputs": [
      {
        "name": "Motor",
        "type": "BOOL",
        "address": "%Q0.0",
        "comment": "Motor contactor command"
      },
      {
        "name": "StopLamp",
        "type": "BOOL",
        "address": "%Q0.1",
        "comment": "Lamp that shows the stop circuit is open"
      }
    ]
  },
  "rungs": [
    {
      "id": "rung_1",
      "number": 1,
      "comment": "Motor rung: StopButton is TRUE at rest, so this contact must be the other kind.",
      "branches": [],
      "gridConfig": {
        "cols": 8,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "id": "e0_0_1",
              "type": "contact_no",
              "variable": "StartButton",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": {
              "id": "e0_1_1",
              "type": "contact_nc",
              "variable": "StopButton",
              "row": 0,
              "col": 1
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": {
              "id": "e0_7_1",
              "type": "coil",
              "variable": "Motor",
              "row": 0,
              "col": 7
            },
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_2",
      "number": 2,
      "comment": "Lamp rung: the lamp must be lit when StopButton is FALSE, so this contact must be the other kind too.",
      "branches": [],
      "gridConfig": {
        "cols": 8,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
