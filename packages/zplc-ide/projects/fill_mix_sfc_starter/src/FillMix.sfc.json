{
  "name": "FillMix",
  "description": "A three-step sequence: wait for Start, fill, mix.",
  "version": "1.0.0",
  "variables": {
    "local": [],
    "inputs": [
      {
        "name": "Start",
        "type": "BOOL",
        "address": "%I0.0",
        "comment": "Start pushbutton"
      }
    ],
    "outputs": [
      {
        "name": "Valve",
        "type": "BOOL",
        "address": "%Q0.0",
        "comment": "Fill valve"
      },
      {
        "name": "Mixer",
        "type": "BOOL",
        "address": "%Q0.1",
        "comment": "Mixer motor"
      }
    ]
  },
  "steps": [
    {
      "id": "step_idle",
      "name": "IDLE",
      "isInitial": true,
      "position": {
        "x": 200,
        "y": 50
      },
      "actions": [
        {
          "qualifier": "N",
          "actionName": "A_IDLE",
          "comment": "Everything off"
        }
      ]
    },
    {
      "id": "step_fill",
      "name": "FILL",
      "isInitial": false,
      "position": {
        "x": 200,
        "y": 250
      },
      "actions": [
        {
          "qualifier": "N",
          "actionName": "A_FILL",
          "comment": "Open the fill valve"
        }
      ]
    },
    {
      "id": "step_mix",
      "name": "MIX",
      "isInitial": false,
      "position": {
        "x": 200,
        "y": 450
      },
      "actions": [
        {
          "qualifier": "N",
          "actionName": "A_MIX",
          "comment": "Run the mixer"
        }
      ]
    }
  ],
  "transitions": [
    {
      "id": "t_start",
      "fromStep": "step_idle",
      "toStep": "step_fill",
      "condition": "Start",
      "comment": "",
      "position": {
        "x": 200,
        "y": 150
      }
    },
    {
      "id": "t_mix_done",
      "fromStep": "step_mix",
      "toStep": "step_idle",
      "condition": "step_mix.T >= T#50ms",
      "comment": "",
      "position": {
        "x": 200,
        "y": 550
      }
    }
  ],
  "actions": [
    {
      "id": "A_IDLE",
      "name": "A_IDLE",
      "type": "ST",
      "body": "Valve := FALSE; Mixer := FALSE;"
    },
    {
      "id": "A_FILL",
      "name": "A_FILL",
      "type": "ST",
      "body": "Valve := TRUE; Mixer := FALSE;"
    },
    {
      "id": "A_MIX",
      "name": "A_MIX",
      "type": "ST",
      "body": "Valve := FALSE; Mixer := TRUE;"
    }
  ],
  "metadata": {
    "author": "ZPLC Team",
    "created": "2026-10-19",
    "iecStandard": "IEC 61131-3",
    "notes": []
  }
}
