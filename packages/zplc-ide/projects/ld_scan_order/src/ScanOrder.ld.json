{
  "name": "ScanOrder",
  "description": "Two rungs that pass the button to a lamp through a memory bit; the order of the rungs decides when the lamp follows.",
  "version": "1.0.0",
  "variables": {
    "local": [
      {
        "name": "ButtonSeen",
        "type": "BOOL",
        "initialValue": false,
        "comment": "Remembers, inside the program, that the button is pressed"
      }
    ],
    "inputs": [
      {
        "name": "StartButton",
        "type": "BOOL",
        "address": "%I0.0",
        "comment": "Start pushbutton, normally open: TRUE while pressed"
      }
    ],
    "outputs": [
      {
        "name": "Lamp",
        "type": "BOOL",
        "address": "%Q0.0",
        "comment": "Lamp: TRUE lights it"
      }
    ]
  },
  "rungs": [
    {
      "id": "rung_1",
      "number": 1,
      "comment": "Copy the button into ButtonSeen.",
      "branches": [],
      "gridConfig": {
        "cols": 8,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "id": "e0_0_1",
              "type": "contact_no",
              "variable": "StartButton",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
