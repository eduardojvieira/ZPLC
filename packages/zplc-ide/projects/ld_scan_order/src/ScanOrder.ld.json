          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": {
              "id": "e0_7_1",
              "type": "coil",
              "variable": "ButtonSeen",
              "row": 0,
              "col": 7
            },
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_2",
      "number": 2,
      "comment": "Show ButtonSeen on the lamp.",
