{
  "name": "Warehouse",
  "description": "A stacker-crane warehouse: store each box on the infeed in the first free cell and retrieve a cell on request.",
  "version": "1.0.0",
  "variables": {
    "local": [
      {
        "name": "Cell",
        "type": "INT",
        "initialValue": 0,
        "comment": "The cell of the job: its column, on level 1"
      },
      {
        "name": "Served",
        "type": "INT",
        "initialValue": 0,
        "comment": "Retrievals finished"
      },
      {
        "name": "Held1",
        "type": "BOOL",
        "initialValue": false,
        "comment": "Cell 1 holds a box"
      },
      {
        "name": "Held2",
        "type": "BOOL",
        "initialValue": false,
        "comment": "Cell 2 holds a box"
      },
      {
        "name": "Held3",
        "type": "BOOL",
        "initialValue": false,
        "comment": "Cell 3 holds a box"
      },
      {
        "name": "Want1",
        "type": "BOOL",
        "initialValue": false,
        "comment": "A retrieval of cell 1 is waiting"
      },
      {
        "name": "Want2",
        "type": "BOOL",
        "initialValue": false,
        "comment": "A retrieval of cell 2 is waiting"
      },
      {
        "name": "Want3",
        "type": "BOOL",
        "initialValue": false,
        "comment": "A retrieval of cell 3 is waiting"
      }
    ],
    "inputs": [
      {
        "name": "Start",
        "type": "BOOL",
        "address": "%IX0.0",
        "comment": "StartButton.pressed: start the warehouse"
      },
      {
        "name": "Req1",
        "type": "BOOL",
        "address": "%IX0.1",
        "comment": "Req1.pressed: retrieve the box of cell 1"
      },
      {
        "name": "Req2",
        "type": "BOOL",
        "address": "%IX0.2",
        "comment": "Req2.pressed: retrieve the box of cell 2"
      },
      {
        "name": "Req3",
        "type": "BOOL",
        "address": "%IX0.3",
        "comment": "Req3.pressed: retrieve the box of cell 3"
      },
      {
        "name": "InEye",
        "type": "BOOL",
        "address": "%IX0.4",
        "comment": "InEye.detect: a box waits at the end of the infeed belt"
      },
      {
        "name": "InPos",
        "type": "BOOL",
        "address": "%IX0.5",
        "comment": "Crane1.inPosition: both axes are at their setpoint"
      },
      {
        "name": "Raised",
        "type": "BOOL",
        "address": "%IX0.6",
        "comment": "Crane1.raised: the fork is raised"
      },
      {
        "name": "Centre",
        "type": "BOOL",
        "address": "%IX0.7",
        "comment": "Crane1.forkCentre: the fork is retracted"
      },
      {
        "name": "AtLeft",
        "type": "BOOL",
        "address": "%IX1.0",
        "comment": "Crane1.forkAtLeft: the fork is out towards the infeed"
      },
      {
        "name": "AtRight",
        "type": "BOOL",
        "address": "%IX1.1",
        "comment": "Crane1.forkAtRight: the fork is out towards the rack and the outfeed"
      },
      {
        "name": "Loaded",
        "type": "BOOL",
        "address": "%IX1.2",
        "comment": "Crane1.loaded: a box rests on the fork"
      }
    ],
    "outputs": [
      {
        "name": "Bay",
        "type": "INT",
        "address": "%QW1",
        "comment": "Crane1.bay: 0 is the dock, 1 to 3 are the columns"
      },
      {
        "name": "Level",
        "type": "INT",
        "address": "%QW2",
        "comment": "Crane1.level: 0 is the dock, 1 and 2 are the shelves"
      },
      {
        "name": "Raise",
        "type": "BOOL",
        "address": "%QX0.0",
        "comment": "Crane1.raise"
      },
      {
        "name": "ForkLeft",
        "type": "BOOL",
        "address": "%QX0.1",
        "comment": "Crane1.forkLeft"
      },
      {
        "name": "ForkRight",
        "type": "BOOL",
        "address": "%QX0.2",
        "comment": "Crane1.forkRight"
      },
      {
        "name": "BeltRight",
        "type": "BOOL",
        "address": "%QX0.3",
        "comment": "Crane1.beltRight"
      },
      {
        "name": "RunIn",
        "type": "BOOL",
        "address": "%QX0.4",
        "comment": "Infeed.run"
      },
      {
        "name": "RunOut",
        "type": "BOOL",
        "address": "%QX0.5",
        "comment": "Outfeed.run"
      },
      {
        "name": "Green",
        "type": "BOOL",
        "address": "%QX0.6",
        "comment": "StackLight1.green: every request is served"
      }
    ]
  },
