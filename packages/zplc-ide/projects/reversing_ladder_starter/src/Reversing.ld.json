{
  "name": "Reversing",
  "description": "Starter: both directions hold themselves on behind LubeOk, but nothing stops both contactors from closing together.",
  "version": "1.0.0",
  "variables": {
    "local": [],
    "inputs": [
      {
        "name": "FwdPB",
        "type": "BOOL",
        "address": "%I0.0",
        "comment": "Forward pushbutton, normally open: TRUE while pressed"
      },
      {
        "name": "RevPB",
        "type": "BOOL",
        "address": "%I0.1",
        "comment": "Reverse pushbutton, normally open: TRUE while pressed"
      },
      {
        "name": "StopPB",
        "type": "BOOL",
        "address": "%I0.2",
        "comment": "Stop pushbutton, normally open: TRUE while pressed. The rung breaks on a press."
      },
      {
        "name": "LubeOk",
        "type": "BOOL",
        "address": "%I0.3",
        "comment": "Lubrication pressure switch: TRUE while the pressure is good. The permissive of both directions."
      }
    ],
    "outputs": [
      {
        "name": "Forward",
        "type": "BOOL",
        "address": "%Q0.0",
        "comment": "Forward contactor"
      },
      {
        "name": "Reverse",
        "type": "BOOL",
        "address": "%Q0.1",
        "comment": "Reverse contactor"
      }
    ]
  },
  "rungs": [
    {
      "id": "rung_1",
      "number": 1,
      "comment": "Forward: StopPB and the permissive LubeOk in series; FwdPB starts the coil, which holds itself on through the contact under FwdPB.",
      "branches": [
        {
          "id": "branch_1",
          "startCol": 1,
          "endCol": 1,
          "rows": [0, 1]
        }
      ],
      "gridConfig": {
        "cols": 8,
        "rows": 2,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "id": "fwd_stoppb_0",
              "type": "contact_nc",
              "variable": "StopPB",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": {
              "id": "fwd_fwdpb_1",
              "type": "contact_no",
              "variable": "FwdPB",
              "row": 0,
              "col": 1
            },
            "hasWire": true
          },
          {
            "element": {
              "id": "fwd_lubeok_2",
              "type": "contact_no",
              "variable": "LubeOk",
              "row": 0,
              "col": 2
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": {
              "id": "fwd_coil",
              "type": "coil",
              "variable": "Forward",
              "row": 0,
              "col": 7
            },
            "hasWire": true
          }
        ],
        [
          {
            "element": null,
            "hasWire": false
          },
