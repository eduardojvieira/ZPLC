{
  "$schema": "../../zplc.schema.json",
  "schemaVersion": 2,
  "name": "Edge Counter",
  "version": "1.0.0",
  "description": "Host-native pulse counter: CTU counts the rising edges of a pulse input up to a preset of 3",
  "target": {
    "board": "posix"
  },
  "tasks": [
    {
      "name": "MainTask",
      "trigger": "cyclic",
      "interval_ms": 10,
      "priority": 1,
      "programs": ["EdgeCounter.st"]
    }
  ]
}
