{
  "name": "TankLevel",
  "description": "Tank fill with a latched fault and an armed Reset.",
  "version": "1.0.0",
  "variables": {
    "local": [
      {
        "name": "FaultLatched",
        "type": "BOOL",
        "initialValue": false,
        "comment": "A fault happened and has not been reset"
      },
      {
        "name": "ResetArmed",
        "type": "BOOL",
        "initialValue": false,
        "comment": "Reset has been seen released while the fault was latched"
      }
    ],
    "inputs": [
      {
        "name": "AutoEnable",
        "type": "BOOL",
        "address": "%I0.0",
        "comment": "Automatic mode: TRUE while the pump may run"
      },
      {
        "name": "LevelLow",
        "type": "BOOL",
        "address": "%I0.1",
        "comment": "Low-level sensor of the tank plant: TRUE while the level is low"
      },
      {
        "name": "LevelHigh",
        "type": "BOOL",
        "address": "%I0.2",
        "comment": "High-level sensor of the tank plant: TRUE while the tank is full"
      },
      {
        "name": "PumpFault",
        "type": "BOOL",
        "address": "%I0.3",
        "comment": "Pump fault from the plant: TRUE while the pump reports a fault"
      },
      {
        "name": "EStop",
        "type": "BOOL",
        "address": "%I0.4",
        "comment": "Emergency stop, active-high here: TRUE while pressed"
      },
      {
        "name": "Reset",
        "type": "BOOL",
        "address": "%I0.5",
        "comment": "Reset pushbutton, normally open: TRUE while pressed"
      }
    ],
    "outputs": [
      {
        "name": "Pump",
        "type": "BOOL",
        "address": "%Q0.0",
        "comment": "Pump command. It is also the memory that keeps the fill going until LevelHigh."
      },
      {
        "name": "Alarm",
        "type": "BOOL",
        "address": "%Q0.1",
        "comment": "Alarm: a fault is present or latched"
      }
    ]
  },
  "rungs": [
