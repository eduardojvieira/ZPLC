{
  "name": "BoxEdges",
  "description": "Detect the arrival and the departure of a box with edge contacts.",
  "version": "1.0.0",
  "variables": {
    "local": [],
    "inputs": [
      {
        "name": "BoxSensor",
        "type": "BOOL",
        "address": "%I0.0",
        "comment": "Photo sensor at the conveyor entry: TRUE while a box blocks the beam"
      }
    ],
    "outputs": [
      {
        "name": "BoxArrived",
        "type": "BOOL",
        "address": "%Q0.0",
        "comment": "TRUE for one scan when a box arrives"
      },
      {
        "name": "BoxLeft",
        "type": "BOOL",
        "address": "%Q0.1",
        "comment": "TRUE for one scan when the box leaves"
      }
    ]
  },
  "rungs": [
    {
      "id": "rung_1",
      "number": 1,
      "comment": "BoxArrived copies the sensor, so it stays ON while the box is there. Use a positive transition contact instead.",
      "branches": [],
      "gridConfig": {
        "cols": 8,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "id": "no_BoxSensor_00",
              "type": "contact_no",
              "variable": "BoxSensor",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": {
              "id": "coil_BoxArrived_07",
              "type": "coil",
              "variable": "BoxArrived",
              "row": 0,
              "col": 7
            },
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_2",
      "number": 2,
      "comment": "BoxLeft copies the sensor too. Use a negative transition contact instead.",
      "branches": [],
      "gridConfig": {
        "cols": 8,
        "rows": 1,
        "cellWidth": 80,
