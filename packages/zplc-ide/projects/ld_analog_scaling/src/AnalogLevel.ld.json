{
  "name": "AnalogLevel",
  "description": "Scale the raw counts of an analog input to a level in percent, limit it to 0..100, and light two lamps.",
  "version": "1.0.0",
  "variables": {
    "local": [
      {
        "name": "Ramp",
        "type": "DINT",
        "initialValue": 0,
        "comment": "Stand-in for the knob: counts, grows while Enable is ON"
      },
      {
        "name": "Raw",
        "type": "DINT",
        "initialValue": 0,
        "comment": "The analog input in counts, 0..4095"
      },
      {
        "name": "Scaled",
        "type": "DINT",
        "initialValue": 0,
        "comment": "Raw times 100: the intermediate product, too big for an INT"
      },
      {
        "name": "Quot",
        "type": "DINT",
        "initialValue": 0,
        "comment": "Scaled divided by 4095"
      },
      {
        "name": "Level",
        "type": "DINT",
        "initialValue": 0,
        "comment": "Level in percent, 0..100"
      }
    ],
    "inputs": [
      {
        "name": "Enable",
        "type": "BOOL",
        "address": "%IX0.0",
        "comment": "Turns the stand-in potentiometer up while TRUE"
      }
    ],
    "outputs": [
      {
        "name": "Warn",
        "type": "BOOL",
        "address": "%QX0.0",
        "comment": "Warning lamp: 50 percent or more"
      },
      {
        "name": "HighLevel",
        "type": "BOOL",
        "address": "%QX0.1",
        "comment": "High level lamp: 75 percent or more"
      }
    ]
  },
  "rungs": [
    {
      "id": "rung_1",
      "number": 1,
      "comment": "Stand-in for a potentiometer on an analog input: 410 counts more on each scan while Enable has power.",
      "branches": [],
      "gridConfig": {
        "cols": 6,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "type": "contact_no",
              "variable": "Enable",
              "id": "r1_0",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": {
              "type": "function",
              "functionName": "ADD",
              "operands": ["Ramp", "410"],
              "output": "Ramp",
              "id": "r1_1",
              "row": 0,
              "col": 1
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_2",
      "number": 2,
      "comment": "A 12-bit input never reports more than 4095 counts: LIMIT clamps the stand-in to 0..4095.",
      "branches": [],
      "gridConfig": {
        "cols": 6,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "type": "function",
              "functionName": "LIMIT",
              "operands": ["0", "Ramp", "4095"],
              "output": "Raw",
              "id": "r2_0",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_3",
      "number": 3,
      "comment": "Counts to percent: multiply first, then divide, in a DINT so that the product does not wrap.",
      "branches": [],
      "gridConfig": {
        "cols": 6,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "type": "function",
              "functionName": "MUL",
              "operands": ["Raw", "100"],
              "output": "Scaled",
              "id": "r3_0",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": {
              "type": "function",
              "functionName": "DIV",
              "operands": ["Scaled", "4095"],
              "output": "Quot",
              "id": "r3_1",
              "row": 0,
              "col": 1
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_4",
      "number": 4,
      "comment": "LIMIT keeps the percentage inside 0..100 whatever the sensor reports.",
      "branches": [],
      "gridConfig": {
        "cols": 6,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "type": "function",
              "functionName": "LIMIT",
              "operands": ["0", "Quot", "100"],
              "output": "Level",
              "id": "r4_0",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_5",
      "number": 5,
      "comment": "Warning from 50 percent: the comparison is the condition.",
      "branches": [],
      "gridConfig": {
        "cols": 6,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "type": "function",
              "functionName": "GE",
              "operands": ["Level", "50"],
              "id": "r5_0",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": {
              "type": "coil",
              "variable": "Warn",
              "id": "r5_5",
              "row": 0,
              "col": 5
            },
            "hasWire": true
          }
        ]
      ]
    },
    {
      "id": "rung_6",
      "number": 6,
      "comment": "High level from 75 percent.",
      "branches": [],
      "gridConfig": {
        "cols": 6,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "type": "function",
              "functionName": "GE",
              "operands": ["Level", "75"],
              "id": "r6_0",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
