          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": {
              "type": "coil",
              "variable": "HighLevel",
              "id": "r6_5",
              "row": 0,
              "col": 5
            },
            "hasWire": true
          }
        ]
      ]
    }
  ],
