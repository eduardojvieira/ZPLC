{
  "name": "TankSequence",
  "description": "A tank sequence with step bits: fill, then mix, then drain, one step active at a time.",
  "version": "1.0.0",
  "variables": {
    "local": [
      {
        "name": "StepFill",
        "type": "BOOL",
        "initialValue": false,
        "comment": "Step bit: the fill step is active"
      },
      {
        "name": "StepMix",
        "type": "BOOL",
        "initialValue": false,
        "comment": "Step bit: the mix step is active"
      },
      {
        "name": "StepDrain",
        "type": "BOOL",
        "initialValue": false,
        "comment": "Step bit: the drain step is active"
      },
      {
        "name": "FillTimer",
        "type": "TON",
        "comment": "Time of the fill step"
      },
      {
        "name": "MixTimer",
        "type": "TON",
        "comment": "Time of the mix step"
      },
      {
        "name": "DrainTimer",
        "type": "TON",
        "comment": "Time of the drain step"
      }
    ],
    "inputs": [
      {
        "name": "Start",
        "type": "BOOL",
        "address": "%I0.0",
        "comment": "Start pushbutton, normally open: TRUE while pressed"
      }
    ],
    "outputs": [
      {
        "name": "FillValve",
        "type": "BOOL",
        "address": "%Q0.0",
        "comment": "Fill valve open while the fill step is active"
      },
      {
        "name": "Mixer",
        "type": "BOOL",
        "address": "%Q0.1",
        "comment": "Mixer motor on while the mix step is active"
      },
      {
        "name": "DrainValve",
        "type": "BOOL",
        "address": "%Q0.2",
        "comment": "Drain valve open while the drain step is active"
      }
    ]
  },
