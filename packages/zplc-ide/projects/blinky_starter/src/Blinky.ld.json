{
  "name": "Blinky",
  "description": "Blinky starter - Ladder Diagram: the two timer rungs are drawn; add the SET and RESET coil rungs.",
  "version": "1.0.0",
  "variables": {
    "local": [
      {
        "name": "OffTimer",
        "type": "TON",
        "comment": "Times the OFF half period (runs while the LED is OFF)"
      },
      {
        "name": "OnTimer",
        "type": "TON",
        "comment": "Times the ON half period (runs while the LED is ON)"
      }
    ],
    "outputs": [
      {
        "name": "LED_Output",
        "type": "BOOL",
        "address": "%Q0.0",
        "comment": "Physical LED output"
      }
    ]
  },
  "rungs": [
    {
      "id": "rung_1",
      "number": 1,
      "comment": "OFF phase - OffTimer runs while the LED is OFF and times 500 ms",
      "gridConfig": {
        "cols": 8,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "id": "nc_led_off",
              "type": "contact_nc",
              "variable": "LED_Output",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": {
              "id": "ton_off",
              "type": "function_block",
              "fbType": "TON",
              "instance": "OffTimer",
              "parameters": {
                "IN": "CONNECTED",
                "PT": "T#500ms"
              },
              "row": 0,
              "col": 7
            },
            "hasWire": true
          }
        ]
      ],
      "branches": []
    },
    {
      "id": "rung_2",
      "number": 2,
      "comment": "ON phase - OnTimer runs while the LED is ON and times 500 ms",
      "gridConfig": {
        "cols": 8,
        "rows": 1,
        "cellWidth": 80,
        "cellHeight": 60
      },
      "grid": [
        [
          {
            "element": {
              "id": "no_led_on",
              "type": "contact_no",
              "variable": "LED_Output",
              "row": 0,
              "col": 0
            },
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": null,
            "hasWire": true
          },
          {
            "element": {
              "id": "ton_on",
              "type": "function_block",
              "fbType": "TON",
              "instance": "OnTimer",
              "parameters": {
                "IN": "CONNECTED",
                "PT": "T#500ms"
              },
              "row": 0,
              "col": 7
            },
            "hasWire": true
          }
        ]
      ],
      "branches": []
    }
  ],
  "metadata": {
    "author": "ZPLC Team",
    "created": "2024-12-27",
    "modified": "2026-10-10",
    "iecStandard": "IEC 61131-3",
    "notes": [
      "Exercise: the LED never turns ON because nothing drives LED_Output yet.",
      "Add rung 3: a normally open contact on OffTimer.Q and a SET coil on LED_Output.",
      "Add rung 4: a normally open contact on OnTimer.Q and a RESET coil on LED_Output.",
      "tests/blinky-visual.scenario.json checks the 500 ms half periods."
    ]
  }
}
